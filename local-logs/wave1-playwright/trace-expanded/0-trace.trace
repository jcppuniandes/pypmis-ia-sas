px;\n  font-weight: 800;\n  text-transform: uppercase;\n}\n\n.noticeGrid p,\n.impactGrid p {\n  color: #536472;\n  font-size: 12px;\n  line-height: 1.45;\n  margin: 0;\n}\n\n.noticeGrid small,\n.impactGrid small {\n  color: #667481;\n  font-size: 12px;\n}\n\n.claimCard {\n  gap: 10px;\n}\n\n.claimHeader {\n  align-items: start;\n  display: flex;\n  flex-wrap: wrap;\n  gap: 12px;\n  justify-content: space-between;\n}\n\n.claimHeader > div:last-child {\n  text-align: right;\n}\n\n.claimTrace {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 8px;\n}\n\n.claimTrace span {\n  background: #edf7f7;\n  border-radius: 999px;\n  color: #0b6f71;\n  display: inline-flex;\n  padding: 5px 8px;\n}\n\n.entitlementMatrix {\n  display: grid;\n  gap: 10px;\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n  margin-top: 8px;\n}\n\n.entitlementItem {\n  background: #fbfcfd;\n  border: 1px solid #dfe6eb;\n  border-left: 4px solid #9aa8b4;\n  border-radius: 8px;\n  display: grid;\n  gap: 7px;\n  padding: 10px;\n}\n\n.entitlementItem.satisfied {\n  border-left-color: #0b8f8d;\n}\n\n.entitlementItem.partial {\n  border-left-color: #d49a00;\n}\n\n.entitlementItem.gap {\n  border-left-color: #e85d3f;\n}\n\n.entitlementMeta {\n  align-items: center;\n  display: flex;\n  flex-wrap: wrap;\n  gap: 10px;\n  justify-content: space-between;\n}\n\n.entitlementMeta strong {\n  overflow-wrap: anywhere;\n}\n\n@media (max-width: 1100px) {\n  .projectWorkspace,\n  .unifierFrame {\n    grid-template-columns: 1fr;\n  }\n\n  .projectWorkspace.moduleRailCollapsed {\n    grid-template-columns: 1fr;\n  }\n\n  .projectWorkspace.moduleRailCollapsed .projectWorkspaceRailDock {\n    min-height: 42px;\n  }\n\n  .projectWorkspaceRailToggleDock {\n    height: auto;\n    position: fixed;\n    right: 18px;\n    top: 142px;\n    z-index: 40;\n  }\n\n  .projectWorkspaceRailToggle,\n  .projectWorkspace.moduleRailCollapsed .projectWorkspaceRailToggle {\n    position: static;\n  }\n\n  .navigatorRail {\n    grid-template-c