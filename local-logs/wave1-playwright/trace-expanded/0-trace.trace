nerSummary strong {\n  display: block;\n  font-size: 22px;\n}\n\n.designerSummary span {\n  color: #667481;\n  display: block;\n  font-size: 12px;\n  margin-top: 2px;\n  text-transform: uppercase;\n}\n\n.contractGrid {\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n}\n\n.templateGrid article {\n  position: relative;\n}\n\n.templateGrid p {\n  margin: 8px 0;\n}\n\n.templateStatus {\n  background: #edf7f7;\n  border-radius: 999px;\n  color: #0b6f71 !important;\n  display: inline-flex !important;\n  font-weight: 800;\n  margin-top: 10px;\n  padding: 4px 8px;\n  text-transform: uppercase;\n  width: fit-content;\n}\n\n.alert {\n  border-radius: 8px;\n  padding: 12px;\n}\n\n.alert strong,\n.alert span,\n.alert small {\n  display: block;\n}\n\n.alert strong {\n  margin-bottom: 6px;\n}\n\n.alert span,\n.alert small {\n  font-size: 12px;\n  line-height: 1.4;\n}\n\n.alert.red {\n  background: #fff0ee;\n  border: 1px solid #efb4aa;\n}\n\n.alert.amber {\n  background: #fff7df;\n  border: 1px solid #edcf76;\n}\n\n.alert.green {\n  background: #eaf8f2;\n  border: 1px solid #a8d9c8;\n}\n\ntable {\n  border-collapse: collapse;\n  min-width: 720px;\n  width: 100%;\n}\n\nth,\ntd {\n  border-bottom: 1px solid #e4e8ec;\n  font-size: 13px;\n  padding: 13px 8px;\n  text-align: left;\n  vertical-align: top;\n}\n\nth {\n  background: #f8fafb;\n  color: #667481;\n  font-weight: 700;\n}\n\ntd span {\n  color: #667481;\n  display: block;\n  font-size: 12px;\n  margin-top: 4px;\n}\n\n.viewPanel table,\n.panel table,\n.mappingTable table,\n.recordRegistry table {\n  width: max-content;\n  min-width: 100%;\n}\n\n.aiBrief {\n  color: #344450;\n  font-size: 14px;\n  line-height: 1.55;\n}\n\n.projectWorkspace {\n  align-items: start;\n  display: grid;\n  gap: 16px;\n  grid-template-columns: 280px minmax(0, 1fr);\n  margin: 0 auto 18px;\n  max-width: 1480px;\n  order: 2;\n  width: 100%;\n}\n\n.projectWorkspace.moduleRailCollapsed {\n  grid-template-columns: 32px minmax(0, 1fr);\n}\n\n.project