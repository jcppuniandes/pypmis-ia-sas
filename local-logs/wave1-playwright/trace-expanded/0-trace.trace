px;\n}\n\n.fieldStack {\n  gap: 6px;\n}\n\n.fieldStack label {\n  color: #344450;\n  font-size: 13px;\n  font-weight: 800;\n}\n\n.fieldStack input,\n.loginSubmit {\n  border-radius: 8px;\n  min-height: 44px;\n}\n\n.fieldStack input {\n  border: 1px solid #cfd8df;\n  color: #17212b;\n  font: inherit;\n  padding: 0 12px;\n}\n\n.loginSubmit {\n  background: #17212b;\n  border: 0;\n  color: #ffffff;\n  cursor: pointer;\n  font-size: 14px;\n  font-weight: 800;\n  margin-top: 4px;\n}\n\n.loginSubmit:disabled {\n  cursor: progress;\n  opacity: 0.72;\n}\n\n.loginError {\n  background: #fff0ee;\n  border: 1px solid #ffc8c0;\n  border-radius: 8px;\n  color: #a42626;\n  font-size: 13px;\n  font-weight: 800;\n  padding: 10px 12px;\n}\n\n.productLogo {\n  align-items: center;\n  color: #17212b;\n  display: inline-flex;\n  gap: 12px;\n  min-width: 0;\n}\n\n.productLogo.compact {\n  margin-bottom: 8px;\n}\n\n.productLogoMark {\n  display: block;\n  flex: 0 0 auto;\n  height: 58px;\n  object-fit: contain;\n  width: 58px;\n}\n\n.productLogo.compact .productLogoMark {\n  height: 42px;\n  width: 42px;\n}\n\n.productLogo strong,\n.productLogo span {\n  display: block;\n}\n\n.productLogo strong {\n  font-family: \"Segoe UI\", Arial, sans-serif;\n  font-size: 18px;\n  font-weight: 800;\n  letter-spacing: 0;\n  line-height: 1.1;\n  white-space: nowrap;\n}\n\n.productLogo span {\n  color: #52616f;\n  font-size: 12px;\n  font-weight: 700;\n  letter-spacing: 0;\n  margin-top: 3px;\n}\n\n.appBrandBar {\n  align-items: center;\n  background: #ffffff;\n  border: 1px solid #d8dee5;\n  border-radius: 8px;\n  box-shadow: 0 10px 22px rgba(23, 33, 43, 0.05);\n  color: #344450;\n  display: flex;\n  justify-content: space-between;\n  margin: 0 auto 10px;\n  max-width: 1480px;\n  padding: 10px 16px;\n  width: 100%;\n}\n\n.appBrandBar .productLogo.compact {\n  margin-bottom: 0;\n}\n\n.appBrandBar .productLogo strong {\n  font-size: 19px;\n}\n\n.appBrandBar > span,\n.appBrandTagline {\n  color: #52616f;\n  font-size: 13px;\n  font-weight: 700;\n  letter-spacing: 0;\n  text-align: right;\n}\n\n.appBrandActions {\n  align-items: center;\n  display: flex;\n  gap: 14px;\n  justify-content: flex-end;\n}\n\n.applicationModeToggle {\n  align-items: flex-start;\n  background: #0b6f71;\n  border: 1px solid #0b6f71;\n  border-radius: 8px;\n  color: #ffffff;\n  cursor: pointer;\n  display: flex;\n  flex-direction: column;\n  min-width: 138px;\n  padding: 7px 12px;\n  text-align: left;\n  transition:\n    background 160ms ease,\n    border-color 160ms ease,\n    box-shadow 160ms ease;\n}\n\n.applicationModeToggle.admin {\n  background: #a34720;\n  border-color: #a34720;\n}\n\n.applicationModeToggle:hover,\n.applicationModeToggle:focus-visible {\n  box-shadow: 0 0 0 3px rgba(15, 139, 141, 0.18);\n}\n\n.applicationModeToggle.admin:hover,\n.applicationModeToggle.admin:focus-visible {\n  box-shadow: 0 0 0 3px rgba(163, 71, 32, 0.18);\n}\n\n.applicationModeToggle span {\n  font-size: 9px;\n  font-weight: 800;\n  letter-spacing: 0.08em;\n  opacity: 0.8;\n  text-transform: uppercase;\n}\n\n.applicationModeToggle strong {\n  font-size: 13px;\n  letter-spacing: 0.03em;\n}\n\n#root,\nmain,\n.workspaceSection,\n.workArea,\n.viewPanel,\n.panel,\n.metric {\n  min-width: 0;\n}\n\nmain {\n  display: flex;\n  flex-direction: column;\n  min-height: 100vh;\n  padding: 18px 28px 28px;\n}\n\n.tenantCommandBar {\n  align-items: center;\n  background: #17212b;\n  border-radius: 8px;\n  color: #ffffff;\n  display: grid;\n  gap: 12px;\n  grid-template-columns: minmax(220px, 1fr) minmax(180px, 250px) minmax(180px, 1fr) auto auto;\n  margin: 0 auto 10px;\n  max-width: 1480px;\n  padding: 14px 18px;\n  width: 100%;\n}\n\n.tenantCommandBar label,\n.tenantCommandIdentity,\n.tenantCommandProject {\n  display: grid;\n  gap: 3px;\n  min-width: 0;\n}\n\n.tenantCommandIdentity {\n  align-items: center;\n  grid-template-columns: auto minmax(0, 1fr);\n}\n\n.tenantCommandIdentity > div {\n  display: grid;\n  gap: 2px;\n  min-width: 0;\n}\n\n.tenantCommandBar span,\n.tenantCommandBar label span {\n  color: #b9c7d3;\n  font-size: 12px;\n}\n\n.tenantCommandBar strong {\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.tenantCommandEyebrow {\n  color: #8fb1c9 !important;\n  display: block;\n  font-size: 10px !important;\n  font-weight: 900;\n  letter-spacing: 0;\n  text-transform: uppercase;\n}\n\n.tenantCommandProject h1 {\n  color: #ffffff;\n  font-size: 15px;\n  line-height: 1.2;\n  margin: 0;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.tenantCommandBar select {\n  background: #ffffff;\n  border: 1px solid #8aa0b3;\n  border-radius: 6px;\n  color: #17212b;\n  min-height: 36px;\n  padding: 0 10px;\n}\n\n.tenantCommandUser {\n  display: grid;\n  gap: 2px;\n  justify-items: end;\n  min-width: 0;\n}\n\n.tenantCommandUser strong {\n  color: #ffffff;\n  font-size: 13px;\n  font-weight: 900;\n}\n\n.tenantCommandUser small {\n  color: #b9c7d3;\n  font-size: 11px;\n  max-width: 220px;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.iconButton,\n.iconTextButton {\n  align-items: center;\n  border: 1px solid #cfd8df;\n  border-radius: 6px;\n  cursor: pointer;\n  display: inline-flex;\n  gap: 6px;\n  justify-content: center;\n  min-height: 36px;\n  padding: 0 10px;\n}\n\n.iconButton {\n  aspect-ratio: 1;\n  padding: 0;\n  width: 36px;\n}\n\n.tenantCommandBar .iconButton,\n.tenantCommandBar .iconTextButton {\n  background: #24313d;\n  border-color: #3d5060;\n  color: #ffffff;\n}\n\n.dangerButton {\n  border-color: #b94a48;\n  color: #7f1d1d;\n}\n\n.tenantCommandBar .dangerButton {\n  background: #3a2430;\n  border-color: #8a3b45;\n  color: #ffffff;\n}\n\n.dangerButton:disabled,\n.subtleDanger:disabled {\n  cursor: not-allowed;\n  opacity: 0.55;\n}\n\n.projectCreateDrawer {\n  background: #ffffff;\n  border-left: 1px solid #d8dee5;\n  bottom: 0;\n  box-shadow: -18px 0 32px rgba(23, 33, 43, 0.16);\n  display: grid;\n  gap: 14px;\n  max-width: 520px;\n  overflow-y: auto;\n  padding: 18px;\n  position: fixed;\n  right: 0;\n  top: 0;\n  width: min(520px, 94vw);\n  z-index: 50;\n}\n\n.guidedWorkspace {\n  grid-template-columns: 270px minmax(0, 1fr);\n}\n\n.guidedProcessRail,\n.nextActionPanel,\n.costCurrencyGate {\n  background: #ffffff;\n  border: 1px solid #d8dee5;\n  border-radius: 8px;\n  box-shadow: 0 12px 24px rgba(23, 33, 43, 0.05);\n}\n\n.guidedProcessRail {\n  display: grid;\n  gap: 8px;\n  padding: 14px;\n}\n\n.guidedRailItem {\n  align-items: center;\n  background: #f8fafb;\n  border: 1px solid #e2e8ee;\n  border-radius: 8px;\n  color: #17212b;\n  cursor: pointer;\n  display: grid;\n  gap: 8px;\n  grid-template-columns: auto minmax(0, 1fr) auto;\n  padding: 10px;\n  text-align: left;\n}\n\n.guidedRailItem.active {\n  border-color: #0f8b8d;\n  box-shadow: inset 3px 0 0 #0f8b8d;\n}\n\n.guidedRailItem.blocked {\n  background: #fff7ed;\n}\n\n.guidedRailItem.complete {\n  background: #effaf5;\n}\n\n.guidedRailItem small,\n.nextActionPanel p {\n  color: #52616f;\n  display: block;\n  font-size: 12px;\n  line-height: 1.35;\n  margin: 2px 0 0;\n}\n\n.guidedRailItem em {\n  color: #52616f;\n  font-style: normal;\n  font-weight: 800;\n}\n\n.nextActionPanel {\n  align-items: center;\n  display: grid;\n  gap: 10px;\n  grid-template-columns: minmax(0, 1fr) auto;\n  padding: 14px;\n}\n\n.nextActionPanel > span {\n  color: #0f8b8d;\n  font-size: 12px;\n  font-weight: 800;\n  grid-column: 1 / -1;\n  text-transform: uppercase;\n}\n\n.nextActionPanel strong {\n  font-size: 18px;\n}\n\n.nextActionPanel p {\n  justify-self: end;\n  max-width: 360px;\n  margin: 0;\n}\n\n.nextActionPanel .workflowAction {\n  justify-self: start;\n  min-width: 280px;\n}\n\n.costCurrencyGate {\n  align-items: center;\n  display: grid;\n  gap: 12px;\n  grid-template-columns: minmax(180px, 1fr) minmax(360px, 2fr) auto;\n  margin-bottom: 14px;\n  padding: 14px;\n}\n\n.costCurrencyGate > div:first-child {\n  display: grid;\n  gap: 4px;\n}\n\n.costCurrencyGate > div:first-child span {\n  color: #0f8b8d;\n  font-size: 12px;\n  font-weight: 800;\n}\n\n.costCurrencyGate.blocked {\n  border-color: #f0b36a;\n}\n\n.costCurrencyGate.ready {\n  border-color: #5bb98c;\n}\n\n.loading {\n  display: grid;\n  min-height: 100vh;\n  place-items: center;\n  color: #52616f;\n}\n\n.topbar {\n  align-items: center;\n  background: #ffffff;\n  border: 1px solid #d8dee5;\n  border-radius: 8px;\n  box-shadow: 0 12px 24px rgba(23, 33, 43, 0.05);\n  display: flex;\n  justify-content: space-between;\n  gap: 16px;\n  margin: 0 auto 10px;\n  max-width: 1480px;\n  order: 1;\n  padding: 10px 14px;\n  width: 100%;\n}\n\n.brandBlock {\n  align-items: center;\n  column-gap: 12px;\n  display: grid;\n  grid-template-columns: auto minmax(0, 1fr);\n  min-width: 0;\n  row-gap: 2px;\n}\n\n.brandBlock .productLogo {\n  grid-row: 1 / span 3;\n}\n\n.brandBlock .productLogo.compact {\n  margin-bottom: 0;\n}\n\n.eyebrow {\n  color: #0f8b8d;\n  font-size: 12px;\n  font-weight: 800;\n  letter-spacing: 0;\n  margin: 0 0 6px;\n}\n\nh1,\nh2,\nh3,\np {\n  margin: 0;\n}\n\nh1 {\n  font-size: clamp(30px, 4vw, 48px);\n  letter-spacing: 0;\n  line-height: 1.05;\n  max-width: 920px;\n}\n\n.brandBlock h1 {\n  font-size: clamp(18px, 2vw, 24px);\n  line-height: 1.1;\n  max-width: none;\n}\n\n.brandBlock .eyebrow,\n.brandBlock .productStatement {\n  grid-column: 2;\n}\n\n.productStatement {\n  color: #344450;\n  font-size: 15px;\n  line-height: 1.45;\n  margin: 10px 0 7px;\n  max-width: 980px;\n}\n\n.brandBlock .productStatement {\n  font-size: 12px;\n  margin: 2px 0 0;\n}\n\nh2 {\n  font-size: 16px;\n  letter-spacing: 0;\n}\n\nh3 {\n  font-size: 14px;\n  letter-spacing: 0;\n}\n\n.topbar span,\n.panelHeader span {\n  color: #667481;\n  font-size: 13px;\n}\n\n.projectMeta {\n  display: block;\n}\n\n.headerActions {\n  align-items: center;\n  display: flex;\n  flex: 0 0 auto;\n  flex-wrap: wrap;\n  gap: 10px;\n  justify-content: flex-end;\n}\n\n.contextSwitch {\n  align-items: end;\n  display: grid;\n  gap: 8px;\n  grid-template-columns: 150px 170px auto;\n}\n\n.contextSwitch label {\n  display: grid;\n  gap: 4px;\n}\n\n.contextSwitch label span {\n  color: #667481;\n  font-size: 11px;\n  font-weight: 800;\n  text-transform: uppercase;\n}\n\n.contextSwitch select {\n  background: #ffffff;\n  border: 1px solid #d8dee5;\n  border-radius: 8px;\n  color: #17212b;\n  font: inherit;\n  font-size: 12px;\n  height: 40px;\n  min-width: 0;\n  padding: 0 9px;\n}\n\n.contextSwitch strong {\n  align-items: center;\n  background: #edf7f7;\n  border: 1px solid #b9dcdb;\n  border-radius: 8px;\n  color: #0b6f71;\n  display: inline-flex;\n  font-size: 12px;\n  height: 40px;\n  padding: 0 10px;\n  white-space: nowrap;\n}\n\n.healthBadge {\n  border: 1px solid #d8dee5;\n  border-radius: 8px;\n  min-width: 210px;\n  padding: 10px 12px;\n}\n\n.healthBadge span,\n.controlSummary span {\n  color: #667481;\n  display: block;\n  font-size: 12px;\n  font-weight: 700;\n  margin-bottom: 4px;\n  text-transform: uppercase;\n}\n\n.healthBadge strong,\n.controlSummary strong {\n  display: block;\n  font-size: 14px;\n  overflow-wrap: anywhere;\n}\n\n.healthBadge.critical {\n  background: #fff0ee;\n  border-color: #efb4aa;\n}\n\n.healthBadge.stable {\n  background: #eaf8f2;\n  border-color: #a8d9c8;\n}\n\n.iconButton {\n  align-items: center;\n  background: #1d2d35;\n  border: 0;\n  border-radius: 8px;\n  color: #ffffff;\n  cursor: pointer;\n  display: inline-flex;\n  height: 40px;\n  justify-content: center;\n  width: 40px;\n}\n\n.quickNavButton {\n  align-items: center;\n  background: #ffffff;\n  border: 1px solid #cfd8df;\n  border-radius: 8px;\n  color: #17212b;\n  cursor: pointer;\n  display: inline-flex;\n  font-size: 13px;\n  font-weight: 800;\n  gap: 8px;\n  min-height: 40px;\n  padding: 0 12px;\n  white-space: nowrap;\n}\n\n.quickNavButton.active {\n  background: #edf7f7;\n  border-color: #0f8b8d;\n  color: #0b6f71;\n}\n\n.adminPanel,\n.controlSummary,\n.flowBand,\n.moduleGuide,\n.scheduleGate,\n.metric,\n.panel {\n  background: #ffffff;\n  border: 1px solid #d8dee5;\n  border-radius: 8px;\n  box-shadow: 0 14px 30px rgba(23, 33, 43, 0.05);\n}\n\n.controlSummary {\n  display: grid;\n  gap: 10px;\n  grid-template-columns: repeat(6, minmax(0, 1fr));\n  margin: 0 auto 16px;\n  max-width: 1480px;\n  order: 4;\n  padding: 14px;\n  width: 100%;\n}\n\n.controlSummary div {\n  border-left: 3px solid #d8dee5;\n  min-width: 0;\n  padding: 8px 12px;\n}\n\n.controlSummary div:first-child {\n  border-left-color: #0f8b8d;\n}\n\n.flowBand {\n  align-items: stretch;\n  display: grid;\n  margin: 0 auto 16px;\n  max-width: 1480px;\n  order: 5;\n  overflow-x: auto;\n  padding: 12px;\n  width: 100%;\n}\n\n.informationFlowBand {\n  gap: 12px;\n}\n\n.flowBandHeader {\n  align-items: baseline;\n  display: flex;\n  gap: 12px;\n  justify-content: space-between;\n  min-width: 0;\n}\n\n.flowBandHeader span {\n  color: #667481;\n  font-size: 12px;\n  font-weight: 900;\n  text-transform: uppercase;\n}\n\n.flowBandHeader strong {\n  color: #17212b;\n  font-size: 16px;\n}\n\n.informationFlowTrack {\n  display: grid;\n  gap: 10px;\n  grid-template-columns: repeat(6, minmax(150px, 1fr));\n  min-width: 980px;\n}\n\n.informationFlowStep {\n  background: #fbfcfd;\n  border: 1px solid #d8dee5;\n  border-radius: 8px;\n  color: #17212b;\n  cursor: pointer;\n  display: grid;\n  gap: 6px;\n  grid-template-rows: auto auto auto 1fr;\n  min-height: 142px;\n  min-width: 0;\n  padding: 12px;\n  text-align: left;\n}\n\n.informationFlowStep.active {\n  border-color: #0f8b8d;\n  box-shadow: inset 0 3px 0 #0f8b8d;\n}\n\n.informationFlowStep em {\n  align-items: center;\n  background: #17212b;\n  border-radius: 999px;\n  color: #ffffff;\n  display: inline-flex;\n  font-size: 12px;\n  font-style: normal;\n  font-weight: 900;\n  height: 24px;\n  justify-content: center;\n  width: 24px;\n}\n\n.informationFlowStep span {\n  color: #07111c;\n  font-size: 13px;\n  font-weight: 900;\n  line-height: 1.25;\n}\n\n.informationFlowStep strong {\n  color: #0b6f71;\n  font-size: 12px;\n  line-height: 1.3;\n  overflow-wrap: anywhere;\n}\n\n.informationFlowStep small {\n  color: #52616f;\n  font-size: 11px;\n  line-height: 1.35;\n}\n\n.moduleGuide {\n  align-items: center;\n  display: grid;\n  gap: 18px;\n  grid-template-columns: minmax(0, 1.15fr) minmax(360px, 0.85fr);\n  margin: 0 auto 16px;\n  max-width: 1480px;\n  padding: 16px 18px;\n  width: 100%;\n}\n\n.moduleGuideIntro span,\n.moduleGuideFacts span {\n  color: #667481;\n  display: block;\n  font-size: 12px;\n  font-weight: 800;\n  text-transform: uppercase;\n}\n\n.moduleGuideTitle {\n  color: #17212b;\n  display: block;\n  font-size: 22px;\n  font-weight: 800;\n  margin: 4px 0 6px;\n}\n\n.moduleGuideIntro p {\n  color: #52616f;\n  line-height: 1.45;\n  margin: 0;\n}\n\n.moduleGuideFacts {\n  display: grid;\n  gap: 10px;\n  grid-template-columns: 0.75fr 1.25fr;\n}\n\n.moduleGuideFacts article {\n  background: #f8fafb;\n  border: 1px solid #e4e8ec;\n  border-radius: 8px;\n  min-width: 0;\n  padding: 12px;\n}\n\n.moduleGuideFacts strong {\n  display: block;\n  font-size: 13px;\n  line-height: 1.35;\n  margin-top: 6px;\n}\n\n.opcGapPanel {\n  display: grid;\n  gap: 16px;\n}\n\n.opcGapPanel > .panelHeader > div {\n  display: grid;\n  gap: 4px;\n}\n\n.opcGapPanel > .panelHeader h2,\n.opcGapPanel .panelHeader h3 {\n  align-items: center;\n  display: inline-flex;\n  gap: 8px;\n  margin: 0;\n}\n\n.opcGapPanel > .panelHeader > div > span {\n  color: #52616f;\n  display: block;\n  font-size: 13px;\n  line-height: 1.4;\n}\n\n.opcGapPanel > .panelHeader strong {\n  color: #0b6f71;\n  font-size: 28px;\n}\n\n.opcGapSummary,\n.opcDataSpine,\n.opcGapRegister,\n.opcNextActions {\n  background: #ffffff;\n  border: 1px solid #d8dee5;\n  border-radius: 8px;\n  box-shadow: 0 12px 26px rgba(23, 33, 43, 0.04);\n  min-width: 0;\n  padding: 16px;\n}\n\n.opcGapSummary {\n  display: grid;\n  gap: 12px;\n  grid-template-columns: 0.75fr 1.2fr 1.05fr;\n  padding: 0;\n}\n\n.opcGapSummary article {\n  background: #f8fafb;\n  border: 1px solid #e4e8ec;\n  border-left: 4px solid #0f8b8d;\n  border-radius: 8px;\n  display: grid;\n  gap: 6px;\n  min-height: 112px;\n  padding: 14px;\n}\n\n.opcGapSummary article.ready {\n  border-left-color: #168a5b;\n}\n\n.opcGapSummary article.partial {\n  border-left-color: #c97a13;\n}\n\n.opcGapSummary article.gap {\n  border-left-color: #c43b31;\n}\n\n.opcGapSummary span,\n.opcDataSpine .panelHeader span,\n.opcGapRegister .panelHeader span,\n.opcNextActions .panelHeader span {\n  color: #667481;\n  font-size: 12px;\n  font-weight: 900;\n  text-transform: uppercase;\n}\n\n.opcGapSummary strong {\n  color: #17212b;\n  font-size: 18px;\n  line-height: 1.25;\n}\n\n.opcGapSummary small {\n  color: #52616f;\n  line-height: 1.4;\n}\n\n.opcDataSpine {\n  display: grid;\n  gap: 14px;\n  overflow: visible;\n}\n\n.opcDataSpineTrack {\n  display: grid;\n  gap: 10px;\n  grid-template-columns: repeat(4, minmax(0, 1fr));\n}\n\n.opcSpineStep {\n  background: #fbfcfd;\n  border: 1px solid #d8dee5;\n  border-radius: 8px;\n  display: grid;\n  gap: 7px;\n  min-height: 150px;\n  min-width: 0;\n  padding: 12px;\n}\n\n.opcSpineStep.ready {\n  border-top: 4px solid #168a5b;\n}\n\n.opcSpineStep.partial {\n  border-top: 4px solid #c97a13;\n}\n\n.opcSpineStep.gap {\n  border-top: 4px solid #c43b31;\n}\n\n.opcSpineStep em {\n  align-items: center;\n  background: #17212b;\n  border-radius: 999px;\n  color: #ffffff;\n  display: inline-flex;\n  font-size: 12px;\n  font-style: normal;\n  font-weight: 900;\n  height: 26px;\n  justify-content: center;\n  width: 26px;\n}\n\n.opcSpineStep strong {\n  color: #07111c;\n  font-size: 14px;\n  line-height: 1.25;\n}\n\n.opcSpineStep span {\n  color: #0b6f71;\n  font-size: 12px;\n  font-weight: 900;\n  overflow-wrap: anywhere;\n}\n\n.opcSpineStep small {\n  color: #52616f;\n  font-size: 12px;\n  line-height: 1.35;\n}\n\n.opcGapRegister {\n  overflow-x: auto;\n}\n\n.opcGapRegister table {\n  min-width: 980px;\n}\n\n.opcGapRegister td:first-child strong,\n.opcGapRegister td:first-child span {\n  display: block;\n}\n\n.opcGapRegister td:first-child span {\n  color: #52616f;\n  font-size: 12px;\n  line-height: 1.35;\n  margin-top: 4px;\n}\n\n.opcGapStatus {\n  align-items: center;\n  border-radius: 999px;\n  display: inline-flex;\n  font-size: 12px;\n  font-weight: 900;\n  gap: 6px;\n  min-height: 30px;\n  padding: 0 10px;\n  white-space: nowrap;\n}\n\n.opcGapStatus.ready {\n  background: #e9f7ef;\n  color: #146c43;\n}\n\n.opcGapStatus.partial {\n  background: #fff5e7;\n  color: #8a4f00;\n}\n\n.opcGapStatus.gap {\n  background: #fff0ee;\n  color: #a42626;\n}\n\n.opcNextActions {\n  display: grid;\n  gap: 12px;\n}\n\n.opcNextActions ol {\n  display: grid;\n  gap: 10px;\n  margin: 0;\n  padding-left: 20px;\n}\n\n.opcNextActions li,\n.opcNextActions p {\n  color: #344450;\n  line-height: 1.5;\n  margin: 0;\n}\n\n.flowTrack {\n  align-items: center;\n  display: flex;\n  flex-wrap: wrap;\n  gap: 8px;\n}\n\n.flowStepWrap {\n  align-items: center;\n  display: inline-flex;\n  gap: 8px;\n}\n\n.flowStep {\n  background: #f8fafb;\n  border: 1px solid #e4e8ec;\n  border-radius: 8px;\n  min-width: 160px;\n  padding: 11px 12px;\n}\n\n.flowStep strong {\n  display: block;\n  font-size: 13px;\n  margin-bottom: 6px;\n}\n\n.flowStep span {\n  color: #0f8b8d;\n  font-size: 12px;\n  font-weight: 700;\n  text-transform: uppercase;\n}\n\n.flowArrow {\n  align-self: center;\n  color: #667481;\n}\n\n.scheduleGate {\n  border-left: 5px solid #0f8b8d;\n  display: grid;\n  gap: 14px;\n  margin: 0 auto 16px;\n  max-width: 1480px;\n  order: 2;\n  padding: 16px 18px;\n  width: 100%;\n}\n\n.gateHeader {\n  align-items: center;\n  display: flex;\n  gap: 12px;\n  justify-content: space-between;\n}\n\n.gateIntro {\n  align-items: center;\n  display: flex;\n  gap: 10px;\n}\n\n.uploadButton {\n  align-items: center;\n  background: #17212b;\n  border: 0;\n  border-radius: 8px;\n  color: #ffffff;\n  cursor: pointer;\n  display: inline-flex;\n  flex: 0 0 auto;\n  font-size: 13px;\n  font-weight: 700;\n  gap: 8px;\n  min-height: 40px;\n  padding: 0 14px;\n}\n\n.uploadButton input {\n  display: none;\n}\n\n.uploadButton.disabled {\n  cursor: progress;\n  opacity: 0.7;\n}\n\n.gateIntro strong,\n.gateFacts strong {\n  display: block;\n}\n\n.gateIntro span,\n.gateFacts span,\n.scheduleGate p {\n  color: #667481;\n  font-size: 13px;\n}\n\n.scheduleIntakeModule {\n  margin: 0;\n  max-width: none;\n}\n\n.gateFacts {\n  display: grid;\n  gap: 10px;\n  grid-template-columns: 1.2fr 1.6fr 1fr 0.8fr 1fr;\n}\n\n.gateFacts div {\n  background: #f8fafb;\n  border: 1px solid #e4e8ec;\n  border-radius: 8px;\n  min-width: 0;\n  padding: 10px;\n}\n\n.gateFacts strong {\n  font-size: 14px;\n  margin-top: 4px;\n  overflow-wrap: anywhere;\n}\n\n.uploadMessage {\n  border-radius: 8px;\n  font-weight: 700;\n  padding: 10px 12px;\n}\n\n.uploadMessage.success {\n  background: #eaf8f2;\n  color: #13745a;\n}\n\n.uploadMessage.error {\n  background: #fff0ee;\n  color: #a42626;\n}\n\n.workspaceAdmin,\n.phaseTwoGrid {\n  display: grid;\n  gap: 16px;\n  margin: 0 auto 16px;\n  max-width: 1480px;\n  width: 100%;\n}\n\n.workspaceAdmin {\n  grid-template-columns: minmax(230px, 0.95fr) minmax(220px, 0.85fr) minmax(220px, 0.85fr) minmax(320px, 1.35fr);\n  order: 3;\n}\n\n.flowSetup {\n  align-items: stretch;\n  grid-template-columns: minmax(280px, 0.9fr) minmax(0, 1.6fr);\n  order: 3;\n}\n\n.flowSetup .adminPanel,\n.flowSetup .scheduleGate {\n  margin: 0;\n  max-width: none;\n  width: 100%;\n}\n\n.flowSetup .scheduleGate {\n  min-width: 0;\n}\n\n.phaseTwoGrid {\n  grid-template-columns: repeat(4, minmax(0, 1fr));\n  order: 9;\n}\n\n.adminPanel {\n  display: grid;\n  gap: 10px;\n  min-height: 260px;\n  padding: 18px;\n}\n\n.bpDesignerPanel {\n  min-height: 520px;\n}\n\n.permissionStrip {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 6px;\n}\n\n.permissionStrip span {\n  background: #edf7f7;\n  border: 1px solid #b9dcdb;\n  border-radius: 999px;\n  color: #0b6f71;\n  font-size: 11px;\n  font-weight: 800;\n  padding: 4px 8px;\n  text-transform: uppercase;\n}\n\n.workflowShell {\n  display: grid;\n  gap: 16px;\n  grid-template-columns: 240px minmax(0, 1fr) 280px;\n  margin: 0 auto 16px;\n  max-width: 1480px;\n  order: 6;\n  width: 100%;\n}\n\n.processRail,\n.workflowCanvas,\n.routingPanel {\n  background: #ffffff;\n  border: 1px solid #d8dee5;\n  border-radius: 8px;\n  box-shadow: 0 14px 30px rgba(23, 33, 43, 0.05);\n}\n\n.processRail {\n  padding: 12px;\n}\n\n.railHeader {\n  border-bottom: 1px solid #edf1f4;\n  margin: -12px -12px 10px;\n  padding: 14px 12px;\n}\n\n.railHeader span,\n.workflowHeader span,\n.workflowMeta span,\n.routingPanel span,\n.registryHeader span {\n  color: #667481;\n  display: block;\n  font-size: 12px;\n  font-weight: 800;\n  margin-bottom: 4px;\n  text-transform: uppercase;\n}\n\n.railHeader strong,\n.workflowMeta strong,\n.routingPanel strong {\n  display: block;\n  font-size: 14px;\n}\n\n.railItem {\n  align-items: center;\n  background: transparent;\n  border: 1px solid transparent;\n  border-radius: 8px;\n  color: #17212b;\n  cursor: pointer;\n  display: flex;\n  justify-content: space-between;\n  margin-bottom: 6px;\n  min-height: 42px;\n  padding: 0 10px;\n  text-align: left;\n  width: 100%;\n}\n\n.railItem span {\n  font-size: 13px;\n  font-weight: 700;\n}\n\n.railItem strong {\n  color: #667481;\n  font-size: 11px;\n  text-transform: uppercase;\n}\n\n.railItem.active {\n  background: #edf7f7;\n  border-color: #b9dcdb;\n}\n\n.workflowCanvas {\n  overflow: auto;\n  scrollbar-gutter: stable;\n}\n\n.workflowHeader,\n.registryHeader {\n  align-items: center;\n  border-bottom: 1px solid #edf1f4;\n  display: flex;\n  justify-content: space-between;\n  padding: 14px 18px;\n}\n\n.workflowHeader h2,\n.registryHeader h2 {\n  font-size: 16px;\n}\n\n.workflowMeta {\n  background: #f8fafb;\n  border: 1px solid #e4e8ec;\n  border-radius: 8px;\n  min-width: 130px;\n  padding: 9px 10px;\n}\n\n.stageTrack {\n  align-items: stretch;\n  display: grid;\n  gap: 8px;\n  grid-template-columns: repeat(9, auto);\n  overflow-x: auto;\n  padding: 18px;\n}\n\n.stageCard {\n  border: 1px solid #d8dee5;\n  border-top: 4px solid #8a98a5;\n  border-radius: 8px;\n  min-width: 190px;\n  padding: 12px;\n}\n\n.stageCard span,\n.statusPill {\n  border-radius: 999px;\n  display: inline-flex;\n  font-size: 11px;\n  font-weight: 800;\n  margin-bottom: 10px;\n  padding: 4px 8px;\n  text-transform: uppercase;\n}\n\n.stageCard strong {\n  display: block;\n  font-size: 14px;\n  margin-bottom: 6px;\n}\n\n.stageCard p,\n.stageCard small,\n.routingPanel p {\n  color: #667481;\n  display: block;\n  font-size: 12px;\n  line-height: 1.45;\n}\n\n.stageCard.complete {\n  border-top-color: #1a9b73;\n}\n\n.stageCard.active {\n  border-top-color: #0f8b8d;\n}\n\n.stageCard.pending {\n  border-top-color: #d39214;\n}\n\n.stageCard.queued {\n  border-top-color: #8a98a5;\n}\n\n.stageCard.critical {\n  border-top-color: #c93636;\n}\n\n.stageCard.complete span,\n.statusPill.complete {\n  background: #eaf8f2;\n  color: #13745a;\n}\n\n.stageCard.active span,\n.statusPill.active {\n  background: #edf7f7;\n  color: #0b6f71;\n}\n\n.stageCard.pending span,\n.statusPill.pending,\n.statusPill.amber {\n  background: #fff7df;\n  color: #8b5d04;\n}\n\n.stageCard.queued span {\n  background: #eef2f4;\n  color: #52616f;\n}\n\n.statusPill.queued {\n  background: #eef2f4;\n  color: #52616f;\n}\n\n.stageCard.critical span,\n.statusPill.critical,\n.statusPill.red {\n  background: #fff0ee;\n  color: #a42626;\n}\n\n.stageArrow {\n  align-self: center;\n  color: #8a98a5;\n}\n\n.recordRegistry {\n  border-top: 1px solid #edf1f4;\n  overflow-x: auto;\n}\n\n.recordRegistry table {\n  min-width: 860px;\n}\n\n.routingPanel {\n  display: grid;\n  gap: 0;\n  align-self: start;\n}\n\n.routingPanel div {\n  border-bottom: 1px solid #edf1f4;\n  padding: 16px;\n}\n\n.routingPanel div:last-child {\n  border-bottom: 0;\n}\n\n.actionStack {\n  display: grid;\n  gap: 8px;\n  margin: 10px 0 0;\n}\n\n.actionRow {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 8px;\n}\n\n.actionRow .workflowAction {\n  flex: 1 1 160px;\n}\n\n.workflowAction {\n  align-items: center;\n  border: 0;\n  border-radius: 8px;\n  cursor: pointer;\n  display: inline-flex;\n  font-size: 13px;\n  font-weight: 800;\n  gap: 6px;\n  justify-content: center;\n  min-height: 38px;\n  padding: 0 12px;\n  text-align: center;\n}\n\n.workflowAction:disabled {\n  cursor: progress;\n  opacity: 0.65;\n}\n\n.workflowAction.primary {\n  background: #17212b;\n  color: #ffffff;\n}\n\n.workflowAction.danger {\n  background: #fff0ee;\n  color: #a42626;\n}\n\n.kpiGrid,\n.captureGrid,\n.mainGrid {\n  display: grid;\n  gap: 16px;\n  margin: 0 auto 16px;\n  max-width: 1480px;\n  width: 100%;\n}\n\n.kpiGrid {\n  grid-template-columns: repeat(4, minmax(0, 1fr));\n  order: 7;\n}\n\n.captureGrid {\n  grid-template-columns: repeat(3, minmax(0, 1fr));\n  order: 8;\n}\n\n.metric {\n  min-height: 124px;\n  overflow: visible;\n  padding: 18px;\n  position: relative;\n}\n\n.metric div {\n  align-items: center;\n  color: #52616f;\n  display: flex;\n  gap: 8px;\n  margin-bottom: 14px;\n}\n\n.metric strong {\n  display: block;\n  font-size: 26px;\n  letter-spacing: 0;\n  line-height: 1.1;\n  overflow-wrap: anywhere;\n}\n\n.metric small {\n  color: #667481;\n  display: block;\n  font-size: 12px;\n  margin-top: 8px;\n}\n\n.light {\n  border-radius: 999px;\n  height: 12px;\n  position: absolute;\n  right: 18px;\n  top: 18px;\n  width: 12px;\n}\n\n.green {\n  background: #1a9b73;\n}\n\n.amber {\n  background: #d39214;\n}\n\n.red {\n  background: #c93636;\n}\n\n.mainGrid {\n  grid-template-columns: repeat(3, minmax(0, 1fr));\n  order: 10;\n}\n\n.panel {\n  min-width: 0;\n  min-height: 260px;\n  overflow: auto;\n  padding: 18px;\n  scrollbar-gutter: stable;\n}\n\n.wide {\n  grid-column: span 2;\n}\n\n.panelHeader {\n  align-items: center;\n  border-bottom: 1px solid #edf1f4;\n  display: flex;\n  flex-wrap: wrap;\n  gap: 10px;\n  justify-content: space-between;\n  margin: -18px -18px 16px;\n  padding: 14px 18px;\n}\n\n.panelHeader h2 {\n  align-items: center;\n  display: inline-flex;\n  gap: 8px;\n  min-width: 0;\n  overflow-wrap: anywhere;\n}\n\n.panelHeader span {\n  min-width: 0;\n  overflow-wrap: anywhere;\n  text-align: right;\n}\n\n.loopList,\n.stack,\n.workList,\n.documentGrid,\n.templateGrid,\n.auditList,\n.qualityList,\n.recentList,\n.teamList,\n.contractGrid {\n  display: grid;\n  gap: 10px;\n  min-width: 0;\n}\n\n.loopList div,\n.workList article,\n.documentGrid article,\n.templateGrid article,\n.auditList article,\n.qualityList article,\n.recentList article,\n.teamList article,\n.contractGrid > div {\n  background: #f8fafb;\n  border: 1px solid #e4e8ec;\n  border-radius: 8px;\n  padding: 12px;\n}\n\n.loopList strong,\n.workList strong,\n.documentGrid strong,\n.templateGrid strong,\n.auditList strong,\n.qualityList strong,\n.recentList strong,\n.teamList strong,\n.contractGrid strong {\n  display: block;\n  font-size: 13px;\n  margin-bottom: 6px;\n}\n\n.loopList span,\n.workList span,\n.documentGrid span,\n.documentGrid small,\n.templateGrid span,\n.templateGrid p,\n.templateGrid small,\n.auditList span,\n.auditList small,\n.qualityList p,\n.qualityList small,\n.recentList span,\n.teamList span,\n.teamList small,\n.contractGrid span,\n.contractGrid small {\n  color: #667481;\n  display: block;\n  font-size: 12px;\n  line-height: 1.4;\n}\n\n.panel .stack,\n.panel .workList,\n.panel .documentGrid,\n.panel .templateGrid,\n.panel .auditList,\n.panel .qualityList,\n.panel .recentList,\n.panel .teamList,\n.panel .contractGrid,\n.viewPanel .workList,\n.viewPanel .documentGrid,\n.viewPanel .noticeGrid,\n.viewPanel .impactGrid,\n.viewPanel .entitlementMatrix {\n  max-height: min(64vh, 760px);\n  overflow-y: auto;\n  padding-right: 2px;\n  scrollbar-gutter: stable;\n}\n\n.qualityList article div {\n  align-items: center;\n  display: flex;\n  gap: 8px;\n  justify-content: space-between;\n}\n\n.qualityStatus {\n  border-radius: 999px;\n  display: inline-flex;\n  font-size: 11px;\n  font-weight: 800;\n  padding: 4px 8px;\n  text-transform: uppercase;\n}\n\n.qualityStatus.pass,\n.qualityStatus.open {\n  background: #eaf8f2;\n  color: #13745a;\n}\n\n.qualityStatus.review,\n.qualityStatus.waiting,\n.qualityStatus.not_available {\n  background: #fff7df;\n  color: #8b5d04;\n}\n\n.qualityStatus.fail,\n.qualityStatus.blocked {\n  background: #fff0ee;\n  color: #a42626;\n}\n\n.dcmaMetricsPanel {\n  margin: 12px 0;\n}\n\n.dcmaMetricsTable {\n  overflow-x: auto;\n  scrollbar-gutter: stable;\n}\n\n.dcmaMetricsTable td strong {\n  display: block;\n  font-size: 13px;\n  margin-bottom: 4px;\n}\n\n.processFlowBoard {\n  display: grid;\n  gap: 14px;\n  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));\n}\n\n.processLane {\n  background: #ffffff;\n  border: 1px solid #d8dee5;\n  border-radius: 8px;\n  display: grid;\n  gap: 10px;\n  min-width: 0;\n  padding: 12px;\n}\n\n.processLaneHeader {\n  border-bottom: 1px solid #edf1f4;\n  display: grid;\n  gap: 4px;\n  padding-bottom: 10px;\n}\n\n.processLaneHeader strong {\n  color: #17212b;\n  font-size: 14px;\n}\n\n.processLaneHeader span {\n  color: #667481;\n  font-size: 12px;\n  font-weight: 800;\n}\n\n.processLaneItems {\n  display: grid;\n  gap: 10px;\n}\n\n.processFlowItem {\n  background: #f8fafb;\n  border: 1px solid #e4e8ec;\n  border-left: 4px solid #667481;\n  border-radius: 8px;\n  display: grid;\n  gap: 8px;\n  padding: 12px;\n}\n\n.processFlowItem[role=\"button\"] {\n  cursor: pointer;\n}\n\n.processFlowItem[role=\"button\"]:focus-visible {\n  outline: 3px solid rgba(15, 139, 141, 0.32);\n  outline-offset: 2px;\n}\n\n.processFlowItem.complete,\n.processFlowItem.ready {\n  bor