-gradient(125deg, #102b3a 0%, #155e63 100%);\n  border-radius: 12px;\n  color: #ffffff;\n  display: flex;\n  gap: 24px;\n  justify-content: space-between;\n  padding: 24px;\n}\n\n.enterpriseStrategyHero > div {\n  max-width: 820px;\n}\n\n.enterpriseStrategyHero span,\n.strategicZoneHeading span,\n.strategicPhaseCard header > span,\n.strategicRelationship header span {\n  font-size: 11px;\n  font-weight: 850;\n  letter-spacing: 0.06em;\n  text-transform: uppercase;\n}\n\n.enterpriseStrategyHero h1 {\n  font-size: clamp(24px, 3vw, 36px);\n  margin: 5px 0 8px;\n}\n\n.enterpriseStrategyHero p {\n  color: #e6f2f2;\n  line-height: 1.55;\n  margin: 0;\n}\n\n.enterpriseStrategyHero > strong {\n  background: rgba(255, 255, 255, 0.13);\n  border: 1px solid rgba(255, 255, 255, 0.3);\n  border-radius: 999px;\n  flex: 0 0 auto;\n  font-size: 12px;\n  padding: 8px 12px;\n}\n\n.foundationZone,\n.strategicWorkflowZone,\n.strategicRelationship,\n.strategicPhaseCard {\n  background: #ffffff;\n  border: 1px solid #d8dee5;\n  border-radius: 10px;\n}\n\n.foundationZone,\n.strategicWorkflowZone {\n  padding: 18px;\n}\n\n.strategicZoneHeading {\n  align-items: center;\n  display: flex;\n  gap: 10px;\n}\n\n.strategicZoneHeading > div {\n  min-width: 0;\n}\n\n.strategicZoneHeading h2,\n.strategicRelationship h3,\n.strategicPhaseCard h3 {\n  margin: 3px 0 0;\n}\n\n.strategicZoneHeading > b {\n  border-radius: 999px;\n  font-size: 11px;\n  margin-left: auto;\n  padding: 7px 10px;\n}\n\n.strategicZoneHeading > b.ready {\n  background: #e0f5ec;\n  color: #087b57;\n}\n\n.strategicZoneHeading > b.attention {\n  background: #fff2d6;\n  color: #8d5c00;\n}\n\n.foundationZone > p,\n.strategicRelationship header p,\n.strategicPhaseCard p {\n  color: #566673;\n  line-height: 1.5;\n}\n\n.foundationChecks {\n  display: grid;\n  gap: 10px;\n  grid-template-columns: repeat(4, minmax(0, 1fr));\n  list-style: none;\n  margin: 16px 0;\n  padding: 0;\n}\n\n.foundationChecks li {\n  align-items: flex-start;\n  border: 1px solid #d8dee5;\n  border-radius: 8px;\n  display: flex;\n  gap: 8px;\n  min-width: 0;\n  padding: 12px;\n}\n\n.foundationChecks li.available {\n  border-color: #a9d9c8;\n}\n\n.foundationChecks li.attention {\n  border-color: #eed49d;\n}\n\n.foundationChecks li.available > svg {\n  color: #0b8f6a;\n}\n\n.foundationChecks li.attention > svg {\n  color: #b27400;\n}\n\n.foundationChecks li span {\n  display: grid;\n  gap: 4px;\n  min-width: 0;\n}\n\n.foundationChecks small {\n  color: #667481;\n  line-height: 1.35;\n}\n\n.foundationLoadError {\n  color: #8d5c00 !important;\n  font-size: 13px;\n}\n\n.foundationActions {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 9px;\n}\n\n.foundationActions button,\n.strategicPhaseCard button,\n.strategicRelationship button {\n  align-items: center;\n  background: #17212b;\n  border: 1px solid #17212b;\n  border-radius: 7px;\n  color: #ffffff;\n  cursor: pointer;\n  display: inline-flex;\n  font: inherit;\n  font-size: 12px;\n  font-weight: 800;\n  gap: 6px;\n  justify-content: center;\n  padding: 8px 11px;\n  text-align: left;\n}\n\n.foundationActions button.secondary {\n  background: #ffffff;\n  color: #17212b;\n}\n\n.foundationActions button.start {\n  background: #0b7d78;\n  border-color: #0b7d78;\n}\n\n.strategicWorkflowZone {\n  display: grid;\n  gap: 14px;\n}\n\n.strategicLinearFlow {\n  display: grid;\n  gap: 10px;\n  grid-template-columns: repeat(4, minmax(0, 1fr));\n}\n\n.strategicPhaseCard {\n  display: flex;\n  flex-direction: column;\n  min-width: 0;\n  padding: 14px;\n}\n\n.strategicPhaseCard header {\n  align-items: center;\n  display: flex;\n  flex-wrap: wrap;\n  gap: 7px;\n  justify-content: space-between;\n}\n\n.strategicPhaseCard header > span {\n  color: #0b6f71;\n}\n\n.strategicPhaseCard header small {\n  background: #e9f5f4;\n  border-radius: 999px;\n  color: #0b6f71;\n  font-size: 10px;\n  font-weight: 800;\n  padding: 4px 7px;\n}\n\n.strategicPhaseCard p {\n  flex: 1 1 auto;\n  font-size: 13px;\n}\n\n.strategicPhaseCard button {\n  align-self: flex-start;\n}\n\n.strategicRelationship {\n  border-color: #b9d6d7;\n  padding: 14px;\n}\n\n.strategicRelationship > header {\n  align-items: flex-start;\n  display: flex;\n  gap: 9px;\n}\n\n.strategicRelationship > header p {\n  font-size: 13px;\n  margin: 6px 0 12px;\n}\n\n.strategicParallelBranches,\n.strategicEvidenceGrid {\n  display: grid;\n  gap: 10px;\n}\n\n.strategicParallelBranches {\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n}\n\n.strategicEvidenceGrid {\n  grid-template-columns: repeat(3, minmax(0, 1fr));\n}\n\n.strategicParallelBranches button,\n.strategicEvidenceGrid button {\n  align-items: flex-start;\n  background: #f6fafb;\n  border-color: #d2e2e4;\n  color: #17212b;\n  display: grid;\n  justify-content: stretch;\n}\n\n.strategicParallelBranches button span,\n.strategicEvidenceGrid button span {\n  color: #667481;\n  font-size: 11px;\n  font-weight: 700;\n}\n\n.strategicConvergence {\n  align-items: center;\n  color: #0b6f71;\n  display: flex;\n  gap: 8px;\n  justify-content: center;\n  padding-top: 12px;\n}\n\n.strategicConvergence button {\n  background: #0b6f71;\n  border-color: #0b6f71;\n}\n\n.strategicConvergence.gate button {\n  background: #173f5f;\n  border-color: #173f5f;\n}\n\n.strategicBreadcrumb {\n  align-items: center;\n  background: #f7fafb;\n  border: 1px solid #d8e1e6;\n  border-radius: 8px;\n  display: flex;\n  flex-wrap: wrap;\n  font-size: 12px;\n  gap: 7px;\n  margin-bottom: 12px;\n  padding: 9px 11px;\n}\n\n.strategicBreadcrumb span {\n  align-items: center;\n  color: #667481;\n  display: inline-flex;\n  gap: 7px;\n}\n\n.strategicBreadcrumb span[aria-current=\"page\"] {\n  color: #17212b;\n  font-weight: 800;\n}\n\n.strategicBreadcrumb b {\n  color: #90a0ac;\n}\n\n@media (max-width: 980px) {\n  .foundationChecks,\n  .strategicLinearFlow {\n    grid-template-columns: repeat(2, minmax(0, 1fr));\n  }\n\n  .strategicEvidenceGrid {\n    grid-template-columns: repeat(2, minm