 color: #9aaab2;\n}\n\n.workspaceOperationalGrid {\n  display: grid;\n  gap: 12px;\n  grid-template-columns: 228px minmax(0, 1fr);\n  margin: 0 auto;\n  max-width: 1540px;\n}\n\n.workspaceNavigator {\n  align-self: start;\n  background: #fff;\n  border: 1px solid #cad7dd;\n  border-radius: 10px;\n  display: grid;\n  gap: 4px;\n  padding: 8px;\n  position: sticky;\n  top: 10px;\n}\n.workspaceNavigator header {\n  align-items: center;\n  display: flex;\n  gap: 7px;\n  padding: 8px;\n}\n.workspaceNavigator button {\n  align-items: center;\n  background: transparent;\n  border: 0;\n  border-radius: 7px;\n  color: #203641;\n  cursor: pointer;\n  display: flex;\n  font: inherit;\n  justify-content: space-between;\n  min-height: 38px;\n  padding: 7px 9px;\n  text-align: left;\n}\n.workspaceNavigator button:hover:not(:disabled),\n.workspaceNavigator button.active {\n  background: #e6f4f3;\n  color: #075d61;\n}\n.workspaceNavigator button:disabled {\n  cursor: not-allowed;\n  opacity: 0.68;\n}\n.workspaceNavigator button span {\n  font-size: 0.78rem;\n  font-weight: 750;\n}\n.workspaceNavigator button small {\n  color: #6a7d86;\n  font-size: 0.58rem;\n  font-weight: 900;\n}\n\n.workspaceOperationalContent {\n  display: grid;\n  gap: 12px;\n  min-width: 0;\n}\n.workspaceHomeFacts {\n  display: grid;\n  gap: 10px;\n  grid-template-columns: repeat(4, minmax(0, 1fr));\n}\n.workspaceHomeFacts article,\n.workspaceHomeSection,\n.workspaceHomeEmptyGrid article,\n.workspaceBridge,\n.workspacePlanned,\n.workspaceCapabilityEmpty {\n  background: #fff;\n  border: 1px solid #d4dfe4;\n  border-radius: 10px;\n}\n.workspaceHomeFacts article {\n  display: grid;\n  gap: 5px;\n  min-height: 120px;\n  padding: 14px;\n}\n.workspaceHomeFacts article svg {\n  color: #0d8f8b;\n}\n.workspaceHomeFacts span {\n  color: #657984;\n  font-size: 0.66rem;\n  font-weight: 850;\n  text-transform: uppercase;\n}\n.workspaceHomeFacts strong {\n  font-size: 1rem;\n}\n.workspaceHomeFacts small {\n  color: #526873