;\n  gap: 10px;\n  grid-template-columns: repeat(3, minmax(0, 1fr));\n}\n.myWorkspaceCards article {\n  border: 1px solid #d6e0e4;\n  border-radius: 9px;\n  display: grid;\n  gap: 11px;\n  padding: 13px;\n}\n.myWorkspaceCardTitle {\n  align-items: center;\n  display: grid;\n  gap: 8px;\n  grid-template-columns: auto 1fr auto;\n}\n.myWorkspaceCardTitle span {\n  color: #637983;\n  font-size: 0.62rem;\n  font-weight: 850;\n}\n.myWorkspaceCardTitle h3 {\n  font-size: 0.9rem;\n  margin: 1px 0 0;\n}\n.myWorkspaceCardTitle b {\n  background: #e3f4eb;\n  border-radius: 999px;\n  color: #14633c;\n  font-size: 0.6rem;\n  padding: 5px 7px;\n}\n.myWorkspaceCardTitle b[data-status=\"PENDING\"] {\n  background: #fff0cc;\n  color: #7d5200;\n}\n.myWorkspaceCardTitle b[data-status=\"ARCHIVED\"] {\n  background: #e8ecee;\n  color: #53656e;\n}\n.myWorkspaceCards dl {\n  display: grid;\n  gap: 6px;\n  grid-template-columns: 1fr 1fr;\n  margin: 0;\n}\n.myWorkspaceCards dt {\n  color: #6a7e87;\n  font-size: 0.58rem;\n  font-weight: 800;\n  text-transform: uppercase;\n}\n.myWorkspaceCards dd {\n  align-items: center;\n  display: flex;\n  font-size: 0.72rem;\n  font-weight: 700;\n  gap: 4px;\n  margin: 2px 0 0;\n}\n.myWorkspaceCards article > button {\n  align-items: center;\n  background: #102a3a;\n  border: 0;\n  border-radius: 7px;\n  color: #fff;\n  cursor: pointer;\n  display: inline-flex;\n  font: inherit;\n  font-size: 0.7rem;\n  font-weight: 800;\n  gap: 6px;\n  justify-self: start;\n  padding: 8px 10px;\n}\n.myWorkspaceCards article > button:disabled {\n  cursor: not-allowed;\n  opacity: 0.5;\n}\n.myWorkspacesEmpty {\n  color: #687b84;\n  font-size: 0.78rem;\n}\n\n@media (max-width: 1000px) {\n  .workspaceHeader {\n    grid-template-columns: 1fr;\n  }\n  .workspaceHeader dl {\n    flex-wrap: wrap;\n  }\n  .workspaceOperationalGrid {\n    grid-template-columns: 1fr;\n  }\n  .workspaceNavigator {\n    grid-template-columns: repeat(2, minmax(0, 1fr));\n    position: static;\n  }\n  