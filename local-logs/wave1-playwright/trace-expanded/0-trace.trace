;\n  gap: 4px;\n}\n\n.commercialQueue input,\n.commercialControls select,\n.commercialCreate input,\n.commercialReason input,\n.commercialOverview input,\n.commercialField input,\n.commercialField textarea,\n.commercialRepeater input,\n.commercialRepeater textarea {\n  background: #fff;\n  border: 1px solid #c8d5de;\n  border-radius: 6px;\n  box-sizing: border-box;\n  color: #102536;\n  font: inherit;\n  min-height: 34px;\n  padding: 6px 8px;\n  width: 100%;\n}\n\n.commercialControls {\n  align-items: end;\n  background: #fff;\n  border: 1px solid #d7e0e7;\n  border-radius: 9px;\n  padding: 10px;\n}\n\n.commercialControls label {\n  min-width: min(360px, 100%);\n}\n\n.commercialControls button:disabled,\n.commercialSurface button:disabled,\n.commercialLoadMore:disabled {\n  cursor: not-allowed;\n  opacity: 0.44;\n}\n\n.commercialReason {\n  max-width: 620px;\n}\n\n.commercialSurface {\n  background: #fff;\n  border: 1px solid #d7e0e7;\n  border-radius: 10px;\n  min-width: 0;\n  padding: 13px;\n}\n\n.commercialSurface > header,\n.commercialRepeater > header,\n.commercialReadiness > header {\n  align-items: center;\n  display: flex;\n  gap: 12px;\n  justify-content: space-between;\n}\n\n.commercialSurface > header span:not(.commercialStatus),\n.commercialFacts span {\n  color: #667887;\n  font-size: 0.68rem;\n  font-weight: 850;\n  letter-spacing: 0.06em;\n  text-transform: uppercase;\n}\n\n.commercialSurface h3,\n.commercialSurface h4,\n.commercialSurface p {\n  margin: 3px 0 7px;\n}\n\n.commercialStatus {\n  background: #e8eef2;\n  border-radius: 999px;\n  color: #425764;\n  font-size: 0.72rem;\n  font-weight: 850;\n  padding: 5px 9px;\n}\n\n.commercialStatus.ready {\n  background: #dff3e9;\n  color: #166742;\n}\n\n.commercialStatus.blocked,\n.commercialStatus.stale {\n  background: #fff0e8;\n  color: #8f3c13;\n}\n\n.commercialFacts,\n.commercialPreviewGrid,\n.commercialReadiness > div {\n  display: grid;\n  gap: 8px;\n  grid-template-columns: repeat(auto-fit, minma