Panel select:disabled,\n.adminPanel textarea:disabled,\n.captureForm input:disabled,\n.captureForm select:disabled,\n.captureForm textarea:disabled,\n.panel label:not(.uploadButton) input:disabled,\n.panel label:not(.uploadButton) select:disabled,\n.panel label:not(.uploadButton) textarea:disabled,\n.projectCreateForm input:disabled,\n.projectCreateForm select:disabled,\n.projectCreateForm textarea:disabled,\nform.panel input:disabled,\nform.panel select:disabled,\nform.panel textarea:disabled {\n  background: #f1f4f6;\n  color: #8a98a5;\n}\n\n.formColumns {\n  align-items: start;\n  display: grid;\n  gap: 10px;\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n}\n\n.compactForm {\n  align-items: start;\n  border: 1px solid #edf1f4;\n  border-radius: 8px;\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n  margin-bottom: 12px;\n  padding: 12px;\n}\n\n.compactForm .fullWidth {\n  grid-column: 1 / -1;\n}\n\n.checkboxLine {\n  align-items: center;\n  display: flex;\n  gap: 8px;\n  min-height: 38px;\n}\n\n.checkboxLine input[type=\"checkbox\"] {\n  flex: 0 0 auto;\n  height: 16px;\n  min-height: auto;\n  padding: 0;\n  width: 16px;\n}\n\n.compactForm .workflowAction {\n  align-self: end;\n}\n\n.wbsCatalogForm {\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n  min-height: 0;\n}\n\n.advancedFields {\n  background: #fbfcfd;\n  border: 1px solid #edf1f4;\n  border-radius: 8px;\n  grid-column: 1 / -1;\n  overflow: hidden;\n}\n\n.advancedFields summary {\n  align-items: center;\n  color: #344450;\n  cursor: pointer;\n  display: flex;\n  font-size: 12px;\n  font-weight: 800;\n  justify-content: space-between;\n  list-style: none;\n  min-height: 40px;\n  padding: 0 12px;\n  text-transform: uppercase;\n}\n\n.advancedFields summary::-webkit-details-marker {\n  display: none;\n}\n\n.advancedFields summary::after {\n  color: #667481;\n  content: \"+\";\n  font-size: 18px;\n  line-height: 1;\n}\n\n.advancedFields[open] summary {\n  border-bottom: 1px solid #edf1f4;\n}