fy-content: space-between;\n  padding: 10px 15px;\n}\n\n.capitalPagination > span {\n  color: #607580;\n  font-size: 11px;\n}\n\n.capitalPagination > div {\n  display: flex;\n  gap: 6px;\n}\n\n.capitalDemandDetail > header p {\n  color: #536a76;\n  margin: 7px 0 0;\n  max-width: 900px;\n}\n\n.capitalDetailGrid {\n  display: grid;\n  gap: 9px;\n  grid-template-columns: repeat(3, minmax(0, 1fr));\n  padding: 15px;\n}\n\n.capitalDetailGrid article {\n  background: #f7fafb;\n  border: 1px solid #dbe4e8;\n  border-radius: 8px;\n  display: grid;\n  gap: 4px;\n  padding: 11px;\n}\n\n.capitalDetailGrid article.indicative {\n  background: #fff9ed;\n  border-color: #e7cc92;\n}\n\n.capitalDetailGrid span,\n.capitalDetailGrid small {\n  color: #657985;\n  font-size: 11px;\n}\n\n.capitalActions {\n  border-top: 1px solid #e0e8ec;\n  display: flex;\n  flex-wrap: wrap;\n  gap: 7px;\n  padding: 13px 15px;\n}\n\n.capitalActions button.originate {\n  background: #0a7d78;\n  border-color: #0a7d78;\n  color: #fff;\n}\n\n.capitalTraceGrid {\n  display: grid;\n  gap: 12px;\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n  padding: 0 15px 15px;\n}\n\n.capitalTraceGrid > section {\n  border: 1px solid #dbe4e8;\n  border-radius: 8px;\n  padding: 12px;\n}\n\n.capitalTraceGrid h4 {\n  align-items: center;\n  display: flex;\n  gap: 6px;\n  margin: 0 0 6px;\n}\n\n.capitalTraceGrid p,\n.capitalTraceGrid small {\n  color: #657985;\n  font-size: 11px;\n}\n\n.capitalTraceGrid article {\n  align-items: center;\n  border-top: 1px solid #e1e8eb;\n  display: flex;\n  gap: 8px;\n  justify-content: space-between;\n  padding: 9px 0;\n}\n\n.capitalTraceGrid article > div {\n  display: grid;\n}\n\n.capitalCycleGrid {\n  display: grid;\n  gap: 12px;\n  grid-template-columns: repeat(auto-fit, minmax(270px, 1fr));\n  padding: 15px;\n}\n\n.capitalCycleGrid > article {\n  border: 1px solid #d6e1e6;\n  border-radius: 9px;\n  padding: 13px;\n}\n\n.capitalCycleGrid header {\n  align-items: center;\n  display: