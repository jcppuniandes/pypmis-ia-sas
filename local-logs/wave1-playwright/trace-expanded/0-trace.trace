l h3 {\n  margin: 4px 0 0;\n}\n\n.capitalPrimary,\n.capitalSecondary,\n.capitalActions button,\n.capitalTraceGrid button {\n  align-items: center;\n  border-radius: 7px;\n  cursor: pointer;\n  display: inline-flex;\n  font: inherit;\n  font-size: 12px;\n  font-weight: 800;\n  gap: 6px;\n  justify-content: center;\n  padding: 8px 11px;\n}\n\n.capitalPrimary {\n  background: #0a7d78;\n  border: 1px solid #0a7d78;\n  color: #fff;\n}\n\n.capitalSecondary,\n.capitalActions button,\n.capitalTraceGrid button {\n  background: #fff;\n  border: 1px solid #aebfc8;\n  color: #173646;\n}\n\n.capitalPrimary:disabled,\n.capitalActions button:disabled {\n  cursor: wait;\n  opacity: 0.55;\n}\n\n.capitalToolbar {\n  align-items: center;\n  display: flex;\n  gap: 8px;\n}\n\n.capitalToolbar label {\n  align-items: center;\n  border: 1px solid #becdd5;\n  border-radius: 7px;\n  color: #68808c;\n  display: flex;\n  gap: 6px;\n  padding: 0 9px;\n}\n\n.capitalToolbar input {\n  border: 0;\n  font: inherit;\n  min-width: 260px;\n  outline: none;\n  padding: 9px 0;\n}\n\n.capitalCurrencySummary {\n  background: #f7fafb;\n  border-bottom: 1px solid #dde6ea;\n  padding: 13px 16px;\n}\n\n.capitalFilters {\n  background: #fbfcfd;\n  border-bottom: 1px solid #dde6ea;\n  display: grid;\n  gap: 8px;\n  grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));\n  padding: 12px 16px;\n}\n\n.capitalFilters label {\n  color: #546b77;\n  display: grid;\n  font-size: 10px;\n  font-weight: 800;\n  gap: 4px;\n}\n\n.capitalFilters select {\n  background: #fff;\n  border: 1px solid #bfced6;\n  border-radius: 6px;\n  font: inherit;\n  min-width: 0;\n  padding: 7px;\n}\n\n.capitalFilterActions {\n  align-items: end;\n  display: flex;\n  gap: 6px;\n}\n\n.capitalCurrencySummary > header {\n  align-items: flex-start;\n  display: flex;\n  gap: 8px;\n}\n\n.capitalCurrencySummary > header div {\n  display: grid;\n  gap: 2px;\n}\n\n.capitalCurrencySummary > header span {\n  color: #657985;\n  font-size: 11px;\n}\n