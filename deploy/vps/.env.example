APP_VERSION=0.1.0
COMMIT_SHA=vps
POSTGRES_DB=pypmis
POSTGRES_USER=pypmis
POSTGRES_PASSWORD=change_this_database_password
REDIS_PASSWORD=change_this_redis_password
AUTH_SECRET_KEY=change_this_to_a_64_character_random_secret_before_running
METRICS_TOKEN=change_this_metrics_token
CORS_ORIGINS=https://pypmis.example.com
ALLOWED_HOSTS=pypmis.example.com,localhost,127.0.0.1
HTTP_PORT=80
HSTS_ENABLED=true
LOG_LEVEL=INFO
LOG_FORMAT=json
ACCESS_TOKEN_EXPIRE_MINUTES=120
RATE_LIMIT_REQUESTS=300
LOGIN_RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60
MAX_REQUEST_BODY_MB=25
DOCUMENT_ALLOWED_EXTENSIONS=.pdf,.doc,.docx,.xls,.xlsx,.ppt,.pptx,.zip,.jpg,.jpeg,.png,.csv,.txt,.xml,.xer
DOCUMENT_MAX_UPLOAD_MB=50
DOCUMENT_MAX_ZIP_FILES=200
DOCUMENT_MAX_ZIP_UNCOMPRESSED_MB=250
DOCUMENT_SCAN_MODE=local
DOCUMENT_CLAMAV_HOST=clamav
DOCUMENT_CLAMAV_PORT=3310
OIDC_ENABLED=false
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_AUTHORIZATION_URL=
OIDC_TOKEN_URL=
OIDC_JWKS_URL=
