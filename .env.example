APP_ENVIRONMENT=local
APP_VERSION=0.1.0
COMMIT_SHA=dev
LOG_LEVEL=INFO
LOG_FORMAT=plain
ALLOWED_HOSTS=*
SEED_DEMO_DATA=false
DOCUMENT_ALLOWED_EXTENSIONS=.pdf,.doc,.docx,.xls,.xlsx,.ppt,.pptx,.zip,.jpg,.jpeg,.png,.csv,.txt,.xml,.xer
DOCUMENT_MAX_UPLOAD_MB=50
DOCUMENT_MAX_ZIP_FILES=200
DOCUMENT_MAX_ZIP_UNCOMPRESSED_MB=250
DOCUMENT_SCAN_MODE=local
DOCUMENT_CLAMAV_HOST=clamav
DOCUMENT_CLAMAV_PORT=3310
OIDC_ENABLED=false
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_AUTHORIZATION_URL=
OIDC_TOKEN_URL=
OIDC_JWKS_URL=
AI_PROVIDER=disabled
AI_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_API_KEY=
AI_MAX_TOKENS=512
AI_TIMEOUT_SECONDS=30
BIM_GEOMETRY_CONVERTER_COMMAND=python -m app.services.ifc_geometry_converter --source {source} --output {output}
BIM_GEOMETRY_CONVERTER_TIMEOUT_SECONDS=300
GUNICORN_WORKERS=4
GUNICORN_TIMEOUT_SECONDS=180
GUNICORN_GRACEFUL_TIMEOUT_SECONDS=30
