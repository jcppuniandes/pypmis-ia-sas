\n  padding: 4px 6px;\n  width: 100%;\n}\n\n.bimRibbonCompactAction {\n  align-items: center;\n  align-self: end;\n  background: #ffffff;\n  border: 1px solid #cbd5df;\n  border-radius: 5px;\n  color: #17212b;\n  cursor: pointer;\n  display: inline-flex;\n  font: inherit;\n  font-size: 10px;\n  font-weight: 900;\n  justify-content: center;\n  min-height: 29px;\n  padding: 4px 9px;\n}\n\n.bimRibbonCompactAction:hover {\n  background: #17212b;\n  border-color: #17212b;\n  color: #ffffff;\n}\n\n.bimRibbonClashGroup {\n  min-width: 212px;\n}\n\n.bimRibbonClashGroup > .bimRibbonActions {\n  align-items: center;\n  display: flex;\n}\n\n.bimRibbonClashControl {\n  align-items: end;\n  display: grid;\n  gap: 5px;\n  grid-template-columns: 80px 64px;\n  min-width: 0;\n}\n\n.bimRibbonClashGroup .bimRibbonCompactAction {\n  align-self: stretch;\n}\n\n.bimViewerToolbar {\n  align-items: center;\n  display: inline-flex;\n  flex-wrap: wrap;\n  gap: 6px;\n  justify-content: flex-end;\n}\n\n.bimViewerToolbar button {\n  align-items: center;\n  background: #ffffff;\n  border: 1px solid #cbd5df;\n  border-radius: 7px;\n  color: #17212b;\n  cursor: pointer;\n  display: inline-flex;\n  font-size: 12px;\n  font-weight: 800;\n  gap: 6px;\n  min-height: 34px;\n  padding: 7px 10px;\n}\n\n.bimViewerToolbar button:hover,\n.bimViewerToolbar button.active {\n  background: #10202b;\n  border-color: #10202b;\n  color: #ffffff;\n}\n\n.bimViewerPanelBar {\n  align-items: stretch;\n  background: #f5f7f9;\n  border: 1px solid #d8dee5;\n  border-radius: 8px;\n  display: flex;\n  gap: 8px;\n  padding: 7px;\n}\n\n.bimViewerPanelBar > div {\n  align-content: center;\n  display: grid;\n  gap: 2px;\n  margin-right: auto;\n  min-width: 220px;\n  padding: 2px 8px;\n}\n\n.bimViewerPanelBar > div > span {\n  color: #17212b;\n  font-size: 11px;\n  font-weight: 900;\n  text-transform: uppercase;\n}\n\n.bimViewerPanelBar > div > small {\n  color: #667481;\n  font-size: 11px;\n}\n\n.bimViewerPanelBar button {\n  align-items: center;\n  background: #ffffff;\n  border: 1px solid #cbd5df;\n  border-radius: 7px;\n  color: #334451;\n  cursor: pointer;\n  display: grid;\n  font: inherit;\n  gap: 1px 8px;\n  grid-template-columns: auto auto;\n  min-width: 142px;\n  padding: 7px 11px;\n  text-align: left;\n}\n\n.bimViewerPanelBar button svg {\n  grid-row: 1 / span 2;\n}\n\n.bimViewerPanelBar button span {\n  font-size: 12px;\n  font-weight: 900;\n}\n\n.bimViewerPanelBar button small {\n  color: #7a8791;\n  font-size: 10px;\n  font-weight: 800;\n  text-transform: uppercase;\n}\n\n.bimViewerPanelBar button:hover,\n.bimViewerPanelBar button.active {\n  background: #fff0e8;\n  border-color: #ef8f6a;\n  color: #912e18;\n}\n\n.bimViewerPanelBar button.active small {\n  color: #ad4c32;\n}\n\n.bimSectionAxisGroup {\n  align-items: center;\n  background: #f4f6f8;\n  border: 1px solid #d8dee5;\n  border-radius: 8px;\n  display: inline-flex;\n  gap: 3px;\n  padding: 3px;\n}\n\n.bimSectionAxisGroup button {\n  background: #ffffff;\n  border: 1px solid transparent;\n  border-radius: 6px;\n  color: #344450;\n  cursor: pointer;\n  font-size: 11px;\n  min-height: 26px;\n  padding: 0 8px;\n}\n\n.bimSectionAxisGroup button:hover,\n.bimSectionAxisGroup button.active {\n  background: #17212b;\n  border-color: #17212b;\n  color: #ffffff;\n}\n\n.bimSectionAxisGroup button:disabled {\n  cursor: not-allowed;\n  opacity: 0.45;\n}\n\n.bimOpenIfcTools {\n  display: grid;\n  gap: 10px;\n  grid-template-columns: repeat(5, minmax(0, 1fr));\n  padding: 0 12px;\n}\n\n.bimOpenIfcTools article {\n  background: #f8fafb;\n  border: 1px solid #d8dee5;\n  border-left: 4px solid #0f8b8d;\n  border-radius: 8px;\n  display: grid;\n  gap: 6px;\n  min-width: 0;\n  padding: 10px 12px;\n}\n\n.bimOpenIfcTools label,\n.bimOpenIfcTools article > span {\n  color: #667481;\n  font-size: 11px;\n  font-weight: 900;\n  text-transform: uppercase;\n}\n\n.bimOpenIfcTools strong {\n  color: #17212b;\n  font-size: 14px;\n}\n\n.bimOpenIfcTools small {\n  color: #52616f;\n  font-size: 11px;\n  line-height: 1.35;\n  overflow-wrap: anywhere;\n}\n\n.bimOpenIfcTools select,\n.bimOpenIfcTools input[type=\"number\"] {\n  background: #ffffff;\n  border: 1px solid #cbd5df;\n  border-radius: 7px;\n  color: #17212b;\n  font: inherit;\n  min-height: 34px;\n  min-width: 0;\n  padding: 6px 8px;\n  width: 100%;\n}\n\n.bimOpenIfcTools input[type=\"range\"] {\n  accent-color: #0f8b8d;\n  cursor: pointer;\n  width: 100%;\n}\n\n.bimOpenIfcTools :disabled {\n  cursor: not-allowed;\n  opacity: 0.55;\n}\n\n.bimClashTool > div {\n  display: grid;\n  gap: 6px;\n  grid-template-columns: minmax(70px, 0.55fr) minmax(88px, 0.45fr);\n}\n\n.bimClashTool button,\n.bimClashResults button,\n.bimTreeFilters button {\n  align-items: center;\n  background: #ffffff;\n  border: 1px solid #cbd5df;\n  border-radius: 7px;\n  color: #17212b;\n  cursor: pointer;\n  display: inline-flex;\n  font: inherit;\n  font-size: 11px;\n  font-weight: 900;\n  gap: 5px;\n  justify-content: center;\n  min-height: 32px;\n  padding: 5px 8px;\n}\n\n.bimClashTool button:hover,\n.bimClashResults button:hover,\n.bimTreeFilters button:hover {\n  background: #10202b;\n  border-color: #10202b;\n  color: #ffffff;\n}\n\n.bimClashResults {\n  background: #fff9ef;\n  border: 1px solid #efd19a;\n  border-left: 4px solid #c26a00;\n  border-radius: 8px;\n  display: grid;\n  gap: 10px;\n  margin: 0 12px;\n  padding: 12px;\n}\n\n.bimClashResults .panelHeader {\n  grid-template-columns: minmax(0, 1fr) auto;\n}\n\n.bimClashResults .panelHeader span {\n  color: #667481;\n  display: block;\n  font-size: 12px;\n  margin-top: 3px;\n}\n\n.bimClashList {\n  display: grid;\n  gap: 8px;\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n  max-height: 280px;\n  overflow: auto;\n}\n\n.bimClashList article {\n  align-items: start;\n  background: #ffffff;\n  border: 1px solid #ead9bc;\n  border-radius: 8px;\n  display: grid;\n  gap: 8px;\n  grid-template-columns: minmax(0, 1fr) auto;\n  padding: 9px;\n}\n\n.bimClashList article > div {\n  display: grid;\n  gap: 3px;\n  min-width: 0;\n}\n\n.bimClashList strong,\n.bimClashList span,\n.bimClashList small {\n  overflow-wrap: anywhere;\n}\n\n.bimClashList span,\n.bimClashList small {\n  color: #52616f;\n  font-size: 11px;\n}\n\n.bimOperationStrip {\n  display: grid;\n  gap: 10px;\n  grid-template-columns: repeat(5, minmax(0, 1fr));\n  padding: 0 12px;\n}\n\n.bimOperationStrip article {\n  background: #fbfcfd;\n  border: 1px solid #d8dee5;\n  border-radius: 8px;\n  display: grid;\n  gap: 4px;\n  min-width: 0;\n  padding: 10px 12px;\n}\n\n.bimOperationStrip span {\n  color: #667481;\n  font-size: 11px;\n  font-weight: 900;\n  text-transform: uppercase;\n}\n\n.bimOperationStrip strong {\n  color: #17212b;\n  font-size: 13px;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.bimOperationStrip small {\n  color: #52616f;\n  font-size: 11px;\n  line-height: 1.35;\n  overflow-wrap: anywhere;\n}\n\n.bimViewerCanvasWrap {\n  aspect-ratio: 21 / 9;\n  background: #f7fafb;\n  border: 1px solid #d8dee5;\n  border-radius: 8px;\n  min-height: 520px;\n  overflow: hidden;\n  position: relative;\n  width: 100%;\n}\n\n.bimViewerCanvasWrap canvas {\n  display: block;\n  height: 100%;\n  touch-action: none;\n  width: 100%;\n}\n\n.bimViewerCanvasWrap:focus {\n  box-shadow: 0 0 0 3px rgba(15, 139, 141, 0.18);\n  outline: none;\n}\n\n.bimViewerCanvasMeta {\n  background: rgba(255, 255, 255, 0.9);\n  border: 1px solid rgba(216, 222, 229, 0.9);\n  border-radius: 8px;\n  bottom: 12px;\n  box-shadow: 0 10px 22px rgba(20, 32, 42, 0.08);\n  display: grid;\n  gap: 3px;\n  left: 12px;\n  max-width: min(360px, calc(100% - 24px));\n  padding: 9px 11px;\n  position: absolute;\n}\n\n.bimViewerNavigationHint {\n  background: rgba(18, 32, 43, 0.9);\n  border: 1px solid rgba(255, 255, 255, 0.2);\n  border-radius: 8px;\n  box-shadow: 0 12px 28px rgba(20, 32, 42, 0.14);\n  color: #ffffff;\n  display: grid;\n  gap: 3px;\n  left: 12px;\n  max-width: min(420px, calc(100% - 24px));\n  padding: 9px 11px;\n  position: absolute;\n  top: 12px;\n}\n\n.bimViewerNavigationHint strong,\n.bimViewerNavigationHint span {\n  display: block;\n  overflow-wrap: anywhere;\n}\n\n.bimViewerNavigationHint strong {\n  color: #ffd166;\n  font-size: 12px;\n  text-transform: uppercase;\n}\n\n.bimViewerNavigationHint span {\n  color: #f6fbfa;\n  font-size: 12px;\n  line-height: 1.35;\n}\n\n.bimViewerSelectionBadge {\n  background: rgba(18, 32, 43, 0.92);\n  border: 2px solid #ffd166;\n  border-radius: 8px;\n  box-shadow: 0 12px 28px rgba(20, 32, 42, 0.18);\n  display: grid;\n  gap: 3px;\n  max-width: min(360px, calc(100% - 24px));\n  padding: 9px 11px;\n  position: absolute;\n  right: 12px;\n  top: 12px;\n}\n\n.bimViewerSelectionBadge strong,\n.bimViewerSelectionBadge span {\n  display: block;\n  overflow-wrap: anywhere;\n}\n\n.bimViewerSelectionBadge strong {\n  color: #ffd166;\n  font-size: 12px;\n  text-transform: uppercase;\n}\n\n.bimViewerSelectionBadge span {\n  color: #ffffff;\n  font-size: 12px;\n}\n\n.bimViewerMeasurementBadge {\n  background: rgba(255, 249, 230, 0.96);\n  border: 2px solid #ff9f1c;\n  border-radius: 8px;\n  bottom: 12px;\n  box-shadow: 0 12px 28px rgba(20, 32, 42, 0.18);\n  display: grid;\n  gap: 3px;\n  padding: 9px 11px;\n  position: absolute;\n  right: 12px;\n}\n\n.bimViewerMeasurementBadge strong {\n  color: #9a4d00;\n  font-size: 11px;\n  text-transform: uppercase;\n}\n\n.bimViewerMeasurementBadge span {\n  color: #17212b;\n  font-size: 16px;\n  font-weight: 900;\n}\n\n.bimViewerCanvasMeta strong,\n.bimViewerCanvasMeta span {\n  display: block;\n}\n\n.bimViewerCanvasMeta strong {\n  color: #17212b;\n  font-size: 12px;\n}\n\n.bimViewerCanvasMeta span {\n  color: #52616f;\n  font-size: 11px;\n  line-height: 1.35;\n}\n\n.bimViewerEmptyOverlay {\n  align-content: center;\n  background: rgba(255, 255, 255, 0.92);\n  border: 1px solid #cfd8df;\n  border-left: 4px solid #0f8b8d;\n  border-radius: 10px;\n  box-shadow: 0 18px 46px rgba(20, 32, 42, 0.12);\n  display: grid;\n  gap: 8px;\n  left: 50%;\n  max-width: min(620px, calc(100% - 48px));\n  padding: 18px 20px;\n  position: absolute;\n  text-align: left;\n  top: 50%;\n  transform: translate(-50%, -50%);\n  z-index: 2;\n}\n\n.bimViewerEmptyOverlay strong {\n  color: #10202a;\n  font-size: 15px;\n}\n\n.bimViewerEmptyOverlay span,\n.bimViewerEmptyOverlay small {\n  color: #52616f;\n  font-size: 12px;\n  line-height: 1.45;\n}\n\n.bimViewerEmptyOverlay small:first-of-type {\n  color: #006d75;\n  font-weight: 800;\n}\n\n.bimViewerMetadata {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 8px;\n  padding: 10px 12px 0;\n}\n\n.bimViewerMetadata span {\n  border: 1px solid #d8dee5;\n  border-radius: 6px;\n  color: #17212b;\n  font-size: 12px;\n  font-weight: 800;\n  line-height: 1.2;\n  padding: 6px 8px;\n}\n\n.bimCommercialReadiness {\n  display: grid;\n  gap: 10px;\n  grid-template-columns: repeat(3, minmax(0, 1fr));\n  padding: 0 12px;\n}\n\n.bimCommercialReadiness article {\n  background: #f8fafb;\n  border: 1px solid #d8dee5;\n  border-left: 4px solid #8b98a5;\n  border-radius: 8px;\n  display: grid;\n  gap: 4px;\n  min-width: 0;\n  padding: 10px 12px;\n}\n\n.bimCommercialReadiness article.ready {\n  background: #f2fbf7;\n  border-color: #bfe4d2;\n  border-left-color: #178a5b;\n}\n\n.bimCommercialReadiness article.review {\n  background: #fff8ed;\n  border-color: #f4d6a3;\n  border-left-color: #c26a00;\n}\n\n.bimCommercialReadiness span {\n  color: #667481;\n  font-size: 11px;\n  font-weight: 900;\n  text-transform: uppercase;\n}\n\n.bimCommercialReadiness strong {\n  color: #17212b;\n  font-size: 15px;\n  overflow-wrap: anywhere;\n}\n\n.bimCommercialReadiness small {\n  color: #52616f;\n  font-size: 12px;\n  line-height: 1.35;\n  overflow-wrap: anywhere;\n}\n\n.bimViewerHealth {\n  display: grid;\n  gap: 10px;\n  grid-template-columns: repeat(4, minmax(0, 1fr));\n  padding: 0 12px;\n}\n\n.bimViewerHealth article {\n  background: #fbfcfd;\n  border: 1px solid #d8dee5;\n  border-left: 4px solid #8b98a5;\n  border-radius: 8px;\n  display: grid;\n  gap: 4px;\n  min-width: 0;\n  padding: 10px 12px;\n}\n\n.bimViewerHealth article.ready {\n  background: #f2fbf7;\n  border-color: #bfe4d2;\n  border-left-color: #178a5b;\n}\n\n.bimViewerHealth article.review {\n  background: #fff8ed;\n  border-color: #f4d6a3;\n  border-left-color: #c26a00;\n}\n\n.bimViewerHealth span {\n  color: #667481;\n  font-size: 11px;\n  font-weight: 900;\n  text-transform: uppercase;\n}\n\n.bimViewerHealth strong {\n  color: #17212b;\n  font-size: 14px;\n  overflow-wrap: anywhere;\n}\n\n.bimViewerHealth small {\n  color: #52616f;\n  font-size: 12px;\n  line-height: 1.35;\n  overflow-wrap: anywhere;\n}\n\n.bimInlineAction {\n  align-items: center;\n  background: #ffffff;\n  border: 1px solid #cbd5df;\n  border-radius: 7px;\n  color: #17212b;\n  cursor: pointer;\n  display: inline-flex;\n  font-size: 11px;\n  font-weight: 900;\n  justify-content: center;\n  min-height: 28px;\n  padding: 5px 8px;\n  width: fit-content;\n}\n\n.bimInlineAction:hover {\n  background: #10202b;\n  border-color: #10202b;\n  color: #ffffff;\n}\n\n.bimInlineAction:disabled {\n  cursor: not-allowed;\n  opacity: 0.58;\n}\n\n.bimGeorefPanel {\n  align-items: start;\n  background: #f6fbfa;\n  border: 1px solid #b8deda;\n  border-left: 4px solid #0f8b8d;\n  border-radius: 8px;\n  display: grid;\n  gap: 12px;\n  grid-template-columns: minmax(220px, 0.7fr) minmax(320px, 1.3fr);\n  margin: 0 12px;\n  padding: 12px;\n}\n\n.bimGeorefPanel.muted {\n  background: #f8fafb;\n  border-color: #d8dee5;\n  border-left-color: #8b98a5;\n  grid-template-columns: 1fr;\n}\n\n.bimGeorefPanel strong {\n  color: #10202a;\n}\n\n.bimGeorefPanel span {\n  color: #52616f;\n  font-size: 12px;\n}\n\n.bimGeorefFacts {\n  display: grid;\n  gap: 8px;\n  grid-template-columns: repeat(3, minmax(0, 1fr));\n}\n\n.bimGeorefFacts article {\n  background: #ffffff;\n  border: 1px solid #d8dee5;\n  border-radius: 7px;\n  display: grid;\n  gap: 3px;\n  min-width: 0;\n  padding: 9px 10px;\n}\n\n.bimGeorefFacts article strong {\n  font-size: 12px;\n  overflow-wrap: anywhere;\n}\n\n.bimViewerWorkspace {\n  display: grid;\n  gap: 8px;\n  min-width: 0;\n}\n\n.bimViewerWorkspace.panels-both {\n  grid-template-areas:\n    \"explorer canvas properties\"\n    \"metadata metadata metadata\"\n    \"georef georef georef\";\n  grid-template-columns: minmax(250px, 0.8fr) minmax(360px, 1.45fr) minmax(250px, 0.78fr);\n}\n\n.bimViewerWorkspace.panel-explorer {\n  grid-template-areas:\n    \"explorer canvas\"\n    \"metadata metadata\"\n    \"georef georef\";\n  grid-template-columns: minmax(240px, 0.62fr) minmax(520px, 1.8fr);\n}\n\n.bimViewerWorkspace.panel-properties {\n  grid-template-areas:\n    \"canvas properties\"\n    \"metadata metadata\"\n    \"georef georef\";\n  grid-template-columns: minmax(520px, 1.8fr) minmax(280px, 0.68fr);\n}\n\n.bimViewerWorkspace.panels-hidden {\n  grid-template-areas:\n    \"canvas\"\n    \"metadata\"\n    \"georef\";\n  grid-template-columns: minmax(0, 1fr);\n}\n\n.bimViewerWorkspace > .bimViewerCanvasWrap {\n  grid-area: canvas;\n  height: 100%;\n}\n\n.bimViewerWorkspace > .bimViewerMetadata {\n  grid-area: metadata;\n}\n\n.bimViewerWorkspace > .bimGeorefPanel {\n  grid-area: georef;\n  margin: 0;\n}\n\n.bimViewerInspector {\n  display: contents;\n}\n\n.bimModelTree,\n.bimElementProperties {\n  background: #fbfcfd;\n  border: 1px solid #d8dee5;\n  border-radius: 8px;\n  display: grid;\n  gap: 10px;\n  min-width: 0;\n  padding: 12px;\n}\n\n.bimViewerWorkspace .bimModelTree {\n  grid-area: explorer;\n}\n\n.bimViewerWorkspace .bimElementProperties {\n  grid-area: properties;\n}\n\n.bimViewerWorkspace .bimDockPanel {\n  align-self: stretch;\n  border-color: #b9c2c9;\n  border-radius: 6px;\n  box-shadow: 0 8px 22px rgba(20, 32, 42, 0.08);\n  max-height: 640px;\n  min-height: 520px;\n  overflow: hidden;\n}\n\n.bimViewerWorkspace .bimModelTree {\n  display: flex;\n  flex-direction: column;\n}\n\n.bimViewerWorkspace .bimElementProperties {\n  grid-template-rows: auto minmax(0, 1fr);\n}\n\n.bimViewer .bimDockPanel .panelHeader {\n  align-items: center;\n  background: #2d3135;\n  border-radius: 5px 5px 0 0;\n  color: #ffffff;\n  margin: -12px -12px 2px;\n  min-height: 38px;\n  padding: 8px 11px;\n}\n\n.bimViewer .bimDockPanel .panelHeader span {\n  color: #dfe5e9;\n  font-size: 10px;\n}\n\n.bimModelTree .panelHeader,\n.bimElementProperties .panelHeader {\n  padding: 0;\n}\n\n.bimModelTree h3,\n.bimElementProperties h3 {\n  align-items: center;\n  display: inline-flex;\n  font-size: 13px;\n  gap: 7px;\n  margin: 0;\n}\n\n.bimTreeList {\n  align-content: start;\n  display: grid;\n  flex: 1 1 auto;\n  gap: 8px;\n  grid-auto-rows: max-content;\n  max-height: none;\n  min-height: 0;\n  overflow: auto;\n  padding-right: 4px;\n}\n\n.bimTreeRoot {\n  align-items: center;\n  background: #eef2f4;\n  border: 1px solid #ccd5dc;\n  border-radius: 5px;\n  color: #17212b;\n  display: grid;\n  gap: 8px;\n  grid-template-columns: auto minmax(0, 1fr);\n  padding: 7px 8px;\n}\n\n.bimTreeRoot > div {\n  display: grid;\n  gap: 2px;\n  min-width: 0;\n}\n\n.bimTreeRoot strong,\n.bimTreeRoot small {\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.bimTreeRoot strong {\n  font-size: 12px;\n}\n\n.bimTreeRoot small {\n  color: #667481;\n  font-size: 10px;\n}\n\n.bimObjectTree {\n  background: #ffffff;\n  border: 1px solid #d7dee3;\n  border-radius: 5px;\n  display: block;\n  padding: 5px 3px 10px;\n}\n\n.bimObjectTreeNode,\n.bimObjectTreeLeaf {\n  min-width: 0;\n}\n\n.bimObjectTreeBranchRow,\n.bimObjectTreeLeaf {\n  align-items: center;\n  display: grid;\n  gap: 3px;\n  grid-template-columns: minmax(0, 1fr) auto;\n}\n\n.bimObjectTreeToggle,\n.bimObjectTreeLeaf > button:first-child {\n  align-items: center;\n  background: transparent;\n  border: 0;\n  color: #17212b;\n  cursor: pointer;\n  display: grid;\n  font: inherit;\n  gap: 5px;\n  grid-template-columns: auto minmax(0, 1fr) auto;\n  min-height: 25px;\n  min-width: 0;\n  padding: 3px 4px;\n  text-align: left;\n  width: 100%;\n}\n\n.bimObjectTreeToggle > span:nth-child(2) {\n  font-size: 11px;\n  font-weight: 750;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.bimObjectTreeToggle small {\n  color: #667481;\n  font-size: 10px;\n}\n\n.bimObjectTreeNode.kind-model > .bimObjectTreeBranchRow .bimObjectTreeToggle > span:nth-child(2) {\n  font-weight: 950;\n}\n\n.bimObjectTreeNode.kind-project > .bimObjectTreeBranchRow .bimObjectTreeToggle > span:nth-child(2),\n.bimObjectTreeNode.kind-site > .bimObjectTreeBranchRow .bimObjectTreeToggle > span:nth-child(2),\n.bimObjectTreeNode.kind-building > .bimObjectTreeBranchRow .bimObjectTreeToggle > span:nth-child(2) {\n  font-weight: 850;\n}\n\n.bimObjectTreeGlyph {\n  align-items: center;\n  background: #ffffff;\n  border: 1px solid #aeb9c2;\n  color: #344551;\n  display: inline-flex;\n  font-size: 10px;\n  font-weight: 900;\n  height: 13px;\n  justify-content: center;\n  line-height: 1;\n  width: 13px;\n}\n\n.bimObjectTreeChildren {\n  border-left: 1px dotted #aeb9c2;\n  margin-left: 7px;\n  padding-left: 4px;\n}\n\n.bimObjectTreeLeaf {\n  border-radius: 4px;\n  margin: 1px 0;\n}\n\n.bimObjectTreeLeaf:hover,\n.bimObjectTreeLeaf:focus-within,\n.bimObjectTreeLeaf.active {\n  background: #e8f7f6;\n  box-shadow: inset 3px 0 0 #0f8b8d;\n}\n\n.bimObjectTreeLeaf > button:first-child {\n  grid-template-columns: auto minmax(0, 1fr);\n  padding-block: 4px;\n}\n\n.bimObjectTreeLeaf > button:first-child > span:last-child {\n  display: grid;\n  gap: 1px;\n  min-width: 0;\n}\n\n.bimObjectTreeLeaf strong,\n.bimObjectTreeLeaf small {\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.bimObjectTreeLeaf strong {\n  font-size: 11px;\n}\n\n.bimObjectTreeLeaf small {\n  color: #667481;\n  font-size: 9px;\n}\n\n.bimObjectTreeIsolate {\n  align-items: center;\n  background: transparent;\n  border: 0;\n  border-radius: 4px;\n  color: #667481;\n  cursor: pointer;\n  display: inline-flex;\n  height: 24px;\n  justify-content: center;\n  padding: 0;\n  width: 24px;\n}\n\n.bimObjectTreeIsolate:hover {\n  background: #10202b;\n  color: #ffffff;\n}\n\n.bimObjectTreeIsolate:disabled {\n  cursor: not-allowed;\n  opacity: 0.4;\n}\n\n.bimTreeSearch {\n  align-items: center;\n  background: #ffffff;\n  border: 1px solid #d8dee5;\n  border-radius: 8px;\n  color: #52616f;\n  display: grid;\n  gap: 8px;\n  grid-template-columns: auto 1fr;\n  min-height: 36px;\n  padding: 0 10px;\n}\n\n.bimTreeSearch input {\n  background: transparent;\n  border: 0;\n  color: #17212b;\n  font: inherit;\n  min-width: 0;\n  outline: none;\n  width: 100%;\n}\n\n.bimTreeFilters {\n  align-items: end;\n  display: grid;\n  gap: 7px;\n  grid-template-columns: minmax(140px, 1fr) auto auto;\n}\n\n.bimViewerWorkspace .bimTreeFilters {\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n}\n\n.bimViewerWorkspace .bimTreeFilters label {\n  grid-column: 1 / -1;\n}\n\n.bimViewerWorkspace .bimTreeFilters button {\n  font-size: 10px;\n  min-width: 0;\n  padding-inline: 5px;\n}\n\n.bimTreeFilters label {\n  display: grid;\n  gap: 4px;\n}\n\n.bimTreeFilters label span {\n  color: #667481;\n  font-size: 10px;\n  font-weight: 900;\n  text-transform: uppercase;\n}\n\n.bimTreeFilters select {\n  background: #ffffff;\n  border: 1px solid #cbd5df;\n  border-radius: 7px;\n  color: #17212b;\n  font: inherit;\n  min-height: 32px;\n  min-width: 0;\n  padding: 5px 7px;\n  width: 100%;\n}\n\n.bimTreeFilters button:disabled {\n  cursor: not-allowed;\n  opacity: 0.52;\n}\n\n.bimTreeList article {\n  background: #ffffff;\n  border: 1px solid #dfe6eb;\n  border-left: 4px solid #0f8b8d;\n  border-radius: 8px;\n  display: grid;\n  gap: 6px;\n  grid-template-columns: minmax(0, 1fr) auto;\n  min-width: 0;\n  padding: 8px;\n}\n\n.bimTreeList article.active,\n.bimTreeList article:focus-within,\n.bimTreeList article:hover {\n  background: #eef8f8;\n  border-color: #9ed2d2;\n  border-left-color: #006d75;\n}\n\n.bimTreeList article > button:first-child {\n  background: transparent;\n  border: 0;\n  color: #17212b;\n  cursor: pointer;\n  display: grid;\n  gap: 3px;\n  min-width: 0;\n  padding: 0;\n  text-align: left;\n}\n\n.bimTreeMiniAction {\n  align-items: center;\n  align-self: start;\n  background: #f4f6f8;\n  border: 1px solid #cfd8df;\n  border-radius: 7px;\n  color: #17212b;\n  cursor: pointer;\n  display: inline-flex;\n  font: inherit;\n  font-size: 11px;\n  font-weight: 900;\n  gap: 4px;\n  min-height: 28px;\n  padding: 0 8px;\n  white-space: nowrap;\n}\n\n.bimTreeMiniAction:disabled {\n  cursor: not-allowed;\n  opacity: 0.5;\n}\n\n.bimTreeList strong,\n.bimTreeList span,\n.bimTreeList small {\n  overflow-wrap: anywhere;\n}\n\n.bimTreeList span,\n.bimTreeList small {\n  color: #52616f;\n  font-size: 12px;\n}\n\n.bimElementFacts {\n  display: grid;\n  gap: 8px;\n  grid-template-columns: minmax(0, 1fr);\n  min-height: 0;\n  overflow: auto;\n  padding-right: 4px;\n}\n\n.bimElementFacts article {\n  background: #ffffff;\n  border: 0;\n  border-bottom: 1px solid #e0e5e9;\n  border-radius: 0;\n  display: grid;\n  gap: 4px;\n  min-width: 0;\n  padding: 8px 4px;\n}\n\n.bimElementFacts article.wideFact {\n  grid-column: 1 / -1;\n}\n\n.bimElementFacts span {\n  color: #667481;\n  font-size: 11px;\n  font-weight: 800;\n  text-transform: uppercase;\n}\n\n.bimElementFacts strong {\n  color: #17212b;\n  font-size: 13px;\n  overflow-wrap: anywhere;\n}\n\n.ifcPublishedPropertyGrid {\n  display: grid;\n  gap: 5px;\n  margin-top: 4px;\n}\n\n.ifcPublishedPropertyGrid small {\n  background: #f5f8fa;\n  border: 1px solid #e2e9ee;\n  border-radius: 6px;\n  color: #3e4f5d;\n  font-size: 12px;\n  line-height: 1.35;\n  overflow-wrap: anywhere;\n  padding: 6px 8px;\n}\n\n.geometryApprovalAction {\n  align-self: start;\n  background: #12202b;\n  border: 1px solid #12202b;\n  border-radius: 7px;\n  color: #ffffff;\n  cursor: pointer;\n  font: inherit;\n  font-size: 12px;\n  font-weight: 800;\n  min-height: 32px;\n  margin-top: 6px;\n  padding: 0 10px;\n  width: fit-content;\n}\n\n.geometryApprovalAction:disabled {\n  cursor: not-allowed;\n  opacity: 0.55;\n}\n\n.viewerStatus {\n  background: rgba(255, 255, 255, 0.92);\n  border: 1px solid #d8dee5;\n  border-radius: 8px;\n  color: #52616f;\n  font-size: 12px;\n  font-weight: 800;\n  left: 12px;\n  padding: 8px 10px;\n  position: absolute;\n  top: 12px;\n}\n\n.bimViewerLegend {\n  align-items: center;\n  color: #52616f;\n  display: flex;\n  flex-wrap: wrap;\n  font-size: 12px;\n  font-weight: 800;\n  gap: 10px 16px;\n}\n\n.bimViewerLegend span {\n  align-items: center;\n  display: inline-flex;\n  gap: 6px;\n  min-width: 0;\n  overflow-wrap: anywhere;\n}\n\n.legendDot {\n  border-radius: 999px;\n  display: inline-flex;\n  height: 10px;\n  width: 10px;\n}\n\n.legendDot.mapped {\n  background: #178f5f;\n}\n\n.legendDot.review {\n  background: #c85a3a;\n}\n\n.legendDot.classColor {\n  background: linear-gradient(135deg, #8fa8b5 0%, #c66d55 50%, #719ad1 100%);\n}\n\n.mappingTable {\n  background: #ffffff;\n  border: 1px solid #e4e8ec;\n  border-radius: 8px;\n  margin-top: 16px;\n  overflow: auto;\n  scrollbar-gutter: stable;\n}\n\n.compactHeader {\n  margin: 0 !important;\n}\n\n.agentProfileBlock {\n  display: grid;\n  gap: 4px;\n  min-width: 220px;\n}\n\n.agentProfileBlock h2 {\n  margin: 0;\n}\n\n.agentProfileBlock small {\n  color: #136f8f;\n  font-size: 12px;\n  font-weight: 800;\n  letter-spacing: 0;\n  text-transform: uppercase;\n}\n\n.scenarioGrid {\n  display: grid;\n  gap: 10px;\n  grid-template-columns: repeat(3, minmax(0, 1fr));\n}\n\n.scenarioCard {\n  background: #f8fafb;\n  border: 1px solid #e4e8ec;\n  border-left: 4px solid #8a98a5;\n  border-radius: 8px;\n  display: grid;\n  gap: 10px;\n  padding: 12px;\n}\n\n.scenarioCard.low {\n  border-left-color: #1a9b73;\n}\n\n.scenarioCard.medium {\n  border-left-color: #d39214;\n}\n\n.scenarioCard.high {\n  border-left-color: #c93636;\n}\n\n.scenarioCard strong,\n.productivityCard strong {\n  display: block;\n}\n\n.scenarioCard span,\n.scenarioCard small,\n.productivityCard span,\n.productivityCard small {\n  color: #667481;\n  display: block;\n  font-size: 12px;\n  line-height: 1.4;\n}\n\n.scenarioNumbers {\n  display: grid;\n  gap: 6px;\n}\n\n.scenarioNumbers span strong {\n  color: #17212b;\n  font-size: 14px;\n}\n\n.productivityCard {\n  background: #f8fafb;\n  border: 1px solid #e4e8ec;\n  border-radius: 8px;\n  padding: 14px;\n}\n\n.productivityCard strong {\n  font-size: 30px;\n}\n\n.selectedRecord td {\n  background: #f0faf9;\n}\n\n.bpRecordDetail {\n  border-top: 1px solid #edf1f4;\n  display: grid;\n  gap: 10px;\n  padding: 16px 18px;\n}\n\n.bpRecordDetail span {\n  color: #667481;\n  display: block;\n  font-size: 12px;\n}\n\n.bpRecordDetail strong {\n  color: #17212b;\n}\n\n.bpRecordDetail p {\n  color: #344450;\n  font-size: 14px;\n  line-height: 1.45;\n}\n\n.detailFacts {\n  display: grid;\n  gap: 8px;\n  grid-template-columns: repeat(3, minmax(0, 1fr));\n}\n\n.awpSummary {\n  display: grid;\n  gap: 12px;\n  grid-template-columns: repeat(4, minmax(0, 1fr));\n  margin-bottom: 16px;\n}\n\n.costManagerSummary {\n  display: grid;\n  gap: 12px;\n  grid-template-columns: repeat(4, minmax(0, 1fr));\n  margin-bottom: 16px;\n}\n\n.awpSummary article {\n  background: #fbfcfd;\n  border: 1px solid #dfe6eb;\n  border-radius: 8px;\n  display: grid;\n  gap: 5px;\n  min-height: 92px;\n  padding: 12px;\n}\n\n.costManagerSummary article {\n  background: #fbfcfd;\n  border: 1px solid #dfe6eb;\n  border-radius: 8px;\n  display: grid;\n  gap: 5px;\n  min-height: 92px;\n  padding: 12px;\n}\n\n.awpSummary article.risk {\n  background: #fff4f0;\n  border-color: #ffc3b4;\n}\n\n.costManagerSummary article.risk {\n  background: #fff4f0;\n  border-color: #ffc3b4;\n}\n\n.awpSummary span,\n.costManagerSummary span,\n.subHeader span,\n.packageFacts span {\n  color: #667481;\n  font-size: 12px;\n  font-weight: 700;\n}\n\n.awpSummary strong,\n.costManagerSummary strong {\n  color: #17212b;\n  font-size: 24px;\n  line-height: 1;\n}\n\n.awpSummary small,\n.costManagerSummary small {\n  color: #667481;\n  font-size: 12px;\n}\n\n.subHeader {\n  align-items: center;\n  display: flex;\n  flex-wrap: wrap;\n  gap: 8px;\n  justify-content: space-between;\n  margin-bottom: 10px;\n}\n\n.subHeader.spaced {\n  margin-top: 16px;\n}\n\n.compactList {\n  gap: 8px;\n}\n\n.inlineCostForm {\n  display: grid;\n  gap: 8px;\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n  margin: 12px 0 16px;\n}\n\n.inlineCostForm input,\n.inlineCostForm select {\n  background: #ffffff;\n  border: 1px solid #d8dee5;\n  border-radius: 8px;\n  color: #17212b;\n  font: inherit;\n  min-height: 38px;\n  min-width: 0;\n  padding: 0 10px;\n  width: 100%;\n}\n\n.inlineCostForm input:disabled,\n.inlineCostForm select:disabled {\n  background: #f1f4f6;\n  color: #8a98a5;\n}\n\n.inlineCostForm button,\n.cashFlowForm button {\n  grid-column: 1 / -1;\n}\n\n.cashFlowForm {\n  grid-template-columns: repeat(3, minmax(0, 1fr));\n}\n\n.blockedPackage {\n  border-left-color: #e85d3f !important;\n}\n\n.packageCodingPanel {\n  margin-bottom: 16px;\n}\n\n.packageCodeLegend {\n  display: grid;\n  gap: 10px;\n  grid-template-columns: repeat(3, minmax(0, 1fr));\n}\n\n.packageCodeLegend article {\n  background: #fbfcfd;\n  border: 1px solid #dfe6eb;\n  border-radius: 8px;\n  display: grid;\n  gap: 6px;\n  padding: 10px 12px;\n}\n\n.packageCodeLegend strong {\n  color: #006d75;\n  font-size: 12px;\n}\n\n.packageCodeLegend span {\n  color: #536575;\n  font-size: 11px;\n  line-height: 1.45;\n}\n\n.awpVisualGrid {\n  display: grid;\n  gap: 16px;\n  grid-template-columns: minmax(0, 1.08fr) minmax(320px, 0.92fr);\n  margin-bottom: 16px;\n}\n\n.awpPackageTree {\n  display: grid;\n  gap: 10px;\n  overflow-x: auto;\n  padding: 4px 0;\n}\n\n.awpTreeBranch {\n  display: grid;\n  gap: 8px;\n  min-width: 260px;\n}\n\n.awpTreeNode {\n  background: #fbfcfd;\n  border: 1px solid #dfe6eb;\n  border-left: 4px solid #00949b;\n  border-radius: 8px;\n  display: grid;\n  gap: 5px;\n  padding: 10px 12px;\n}\n\n.awpTreeNode strong {\n  color: #17212b;\n  font-size: 13px;\n}\n\n.awpTreeNode span {\n  color: #344450;\n  font-size: 12px;\n}\n\n.awpTreeNode small {\n  color: #667481;\n  font-size: 11px;\n  font-weight: 700;\n}\n\n.awpTreeNode .wbsTrace {\n  color: #006d75;\n}\n\n.awpTreeNode em {\n  color: #536575;\n  font-size: 11px;\n  font-style: normal;\n  line-height: 1.4;\n}\n\n.awpTreeChildren {\n  border-left: 2px solid #c9d6de;\n  display: grid;\n  gap: 8px;\n  margin-left: 18px;\n  padding-left: 16px;\n}\n\n@media (max-width: 900px) {\n  .packageCodeLegend {\n    grid-template-columns: 1fr;\n  }\n}\n\n.pocRoute {\n  counter-reset: pocRoute;\n  display: grid;\n  gap: 10px;\n  list-style: none;\n  margin: 0;\n  padding: 0;\n}\n\n.pocRoute li {\n  align-items: start;\n  display: grid;\n  gap: 10px;\n  grid-template-columns: 34px minmax(0, 1fr);\n  position: relative;\n}\n\n.pocRoute li:not(:last-child)::after {\n  background: #c9d6de;\n  content: \"\";\n  height: calc(100% - 28px);\n  left: 16px;\n  position: absolute;\n  top: 34px;\n  width: 2px;\n}\n\n.pocRoute li > strong {\n  align-items: center;\n  background: #17212b;\n  border-radius: 999px;\n  color: #ffffff;\n  display: inline-flex;\n  font-size: 12px;\n  height: 34px;\n  justify-content: center;\n  line-height: 1;\n  position: relative;\n  width: 34px;\n  z-index: 1;\n}\n\n.pocRoute li > div {\n  background: #fbfcfd;\n  border: 1px solid #dfe6eb;\n  border-radius: 8px;\n  display: grid;\n  gap: 5px;\n  padding: 10px 12px;\n}\n\n.pocRoute span {\n  color: #006d75;\n  font-size: 12px;\n  font-weight: 800;\n}\n\n.pocRoute p {\n  color: #344450;\n  font-size: 12px;\n  line-height: 1.45;\n  margin: 0