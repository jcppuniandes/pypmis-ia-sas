ns: 1fr;\n  }\n}\n"],["STYLE",{},".enterpriseWorkspace {\n  --enterprise-ink: #102532;\n  --enterprise-muted: #627783;\n  --enterprise-line: #d7e1e5;\n  --enterprise-teal: #0d8f8b;\n  --enterprise-navy: #102a3a;\n  display: grid;\n  gap: 14px;\n  min-width: 0;\n  color: var(--enterprise-ink);\n}\n\n.compactModuleHeader {\n  display: grid;\n  grid-template-columns: minmax(320px, 1fr) auto;\n  align-items: center;\n  gap: 16px;\n  min-height: 72px;\n  padding: 12px 16px;\n  border: 1px solid #c9d8de;\n  border-radius: 10px;\n  background: linear-gradient(135deg, #f8fbfc 0%, #edf6f6 100%);\n}\n\n.compactModuleHeader.user {\n  background: linear-gradient(135deg, #f8fbfd 0%, #edf4f8 100%);\n}\n\n.compactHeaderCopy {\n  min-width: 0;\n}\n\n.compactHeaderEyebrow {\n  display: block;\n  margin-bottom: 2px;\n  color: var(--enterprise-muted);\n  font-size: 0.7rem;\n  font-weight: 800;\n  letter-spacing: 0.08em;\n  text-transform: uppercase;\n}\n\n.compactModuleHeader h2 {\n  margin: 0;\n  overflow: hidden;\n  font-size: clamp(1.2rem, 1.6vw, 1.45rem);\n  letter-spacing: -0.025em;\n  line-height: 1.15;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.compactModuleHeader p {\n  margin: 3px 0 0;\n  overflow: hidden;\n  color: #415965;\n  font-size: 0.82rem;\n  line-height: 1.35;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.compactHeaderSide,\n.compactHeaderMetrics,\n.compactHeaderActions {\n  display: flex;\n  align-items: center;\n  gap: 7px;\n}\n\n.compactHeaderSide {\n  justify-content: flex-end;\n  flex-wrap: wrap;\n}\n\n.compactHeaderMetrics article {\n  display: inline-flex;\n  align-items: baseline;\n  gap: 4px;\n  min-height: 30px;\n  padding: 5px 9px;\n  border: 1px solid rgb(16 42 58 / 13%);\n  border-radius: 999px;\n  background: rgb(255 255 255 / 82%);\n  white-space: nowrap;\n}\n\n.compactHeaderMetrics strong {\n  font-size: 0.88rem;\n}\n\n.compactHeaderMetrics span {\n  color: var(--enterprise-muted);\n  font-size: 0.68rem;\n  font-weight: 750;\n}\n\n.enterpriseHero {\n  display: flex;\n  align-items: stretch;\n  justify-content: space-between;\n  gap: 24px;\n  overflow: hidden;\n  padding: 22px 24px;\n  border: 1px solid #c9d8de;\n  border-radius: 12px;\n  background:\n    radial-gradient(circle at 90% 10%, rgb(20 148 142 / 18%), transparent 30%),\n    linear-gradient(135deg, #f8fbfc 0%, #edf6f6 100%);\n}\n\n.enterpriseHero > div:first-child {\n  max-width: 720px;\n}\n\n.enterpriseHero span,\n.enterprisePanel header span {\n  color: var(--enterprise-muted);\n  font-size: 0.72rem;\n  font-weight: 800;\n  letter-spacing: 0.08em;\n  text-transform: uppercase;\n}\n\n.enterpriseHero h2 {\n  margin: 6px 0 7px;\n  font-size: clamp(1.4rem, 2.3vw, 2rem);\n  letter-spacing: -0.03em;\n}\n\n.enterpriseHero p {\n  margin: 0;\n  color: #415965;\n  line-height: 1.55;\n}\n\n.enterpriseKpis {\n  display: grid;\n  grid-template-columns: repeat(3, minmax(92px, 1fr));\n  gap: 9px;\n  min-width: 330px;\n}\n\n.enterpriseKpis article {\n  display: grid;\n  align-content: center;\n  padding: 13px;\n  border: 1px solid rgb(16 42 58 / 12%);\n  border-radius: 9px;\n  background: rgb(255 255 255 / 78%);\n}\n\n.enterpriseKpis strong {\n  font-size: 1.45rem;\n}\n\n.enterpriseKpis span {\n  margin-top: 3px;\n  letter-spacing: 0.02em;\n  text-transform: none;\n}\n\n.enterpriseTabs {\n  display: flex;\n  gap: 4px;\n  padding: 5px;\n  overflow-x: auto;\n  border: 1px solid #c8d5da;\n  border-radius: 9px;\n  background: #f4f7f8;\n}\n\n.enterpriseTabs button,\n.viewSwitch button {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: 7px;\n  min-height: 38px;\n  padding: 8px 14px;\n  border: 0;\n  border-radius: 6px;\n  background: transparent;\n  color: #344b57;\n  font-weight: 750;\n  white-space: nowrap;\n  cursor: pointer;\n}\n\n.enterpriseTabs button.active,\n.viewSwitch button.active {\n  background: var(--enterprise-navy);\n  color: white;\n  box-shadow: 0 3px 8px rgb(16 42 58 / 18%);\n}\n\n.enterpriseAlert {\n  padding: 11px 14px;\n  border: 1px solid #9dcbd0;\n  border-radius: 8px;\n  background: #f0fafa;\n  color: #23505a;\n}\n\n.enterpriseAlert.error {\n  border-color: #efb9b6;\n  background: #fff4f3;\n  color: #8b2925;\n}\n\n.enterpriseAlert.success {\n  border-color: #a4d6bd;\n  background: #effaf4;\n  color: #176743;\n}\n\n.coreReleaseBanner {\n  align-items: center;\n  background: #edf9f4;\n  border: 1px solid #91d2bd;\n  border-left: 4px solid #168c70;\n  border-radius: 10px;\n  color: #102d29;\n  display: grid;\n  gap: 12px;\n  grid-template-columns: auto minmax(220px, 1fr) auto;\n  margin: 0 0 14px;\n  padding: 12px 15px;\n}\n\n.coreReleaseBanner div {\n  display: grid;\n  gap: 3px;\n}\n\n.coreReleaseBanner span,\n.coreReleaseBanner p {\n  color: #4d6863;\n  font-size: 12px;\n  margin: 0;\n}\n\n.coreReleaseBanner code {\n  background: #fff;\n  border: 1px solid #c8ded7;\n  border-radius: 6px;\n  padding: 5px 7px;\n}\n\n.coreReleaseBanner p {\n  grid-column: 2 / -1;\n}\n\n.coreReleaseBanner.user {\n  background: #eef5fb;\n  border-color: #9dc3df;\n  border-left-color: #236b9c;\n}\n\n.enterpriseAdminGrid,\n.enterpriseCatalogLayout,\n.enterpriseRulesLayout,\n.enterprisePublication,\n.enterpriseExplorerGrid {\n  display: grid;\n  grid-template-columns: minmax(300px, 0.82fr) minmax(460px, 1.45fr);\n  gap: 14px;\n  align-items: start;\n}\n\n.enterprisePanel,\n.enterpriseDetail {\n  border: 1px solid var(--enterprise-line);\n  border-radius: 10px;\n  background: white;\n  box-shadow: 0 4px 15px rgb(27 54 67 / 5%);\n}\n\n.enterprisePanel {\n  padding: 15px;\n}\n\n.enterprisePanel > header {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 12px;\n  margin-bottom: 13px;\n  padding-bottom: 11px;\n  border-bottom: 1px solid #e5ecef;\n}\n\n.enterprisePanel header h3 {\n  margin: 3px 0 0;\n  font-size: 1.05rem;\n}\n\n.enterpriseButton {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: 6px;\n  min-height: 34px;\n  padding: 7px 11px;\n  border: 1px solid #b9c9cf;\n  border-radius: 6px;\n  background: white;\n  color: #1d3d4a;\n  font: inherit;\n  font-weight: 750;\n  cursor: pointer;\n}\n\n.enterpriseButton.primary {\n  border-color: var(--enterprise-navy);\n  background: var(--enterprise-navy);\n  color: white;\n}\n\n.enterpriseButton.danger {\n  border-color: #dfaaa6;\n  color: #a0332d;\n}\n\n.enterpriseButton:disabled,\n.enterpriseTabs button:disabled,\n.viewSwitch button:disabled {\n  opacity: 0.55;\n  cursor: not-allowed;\n}\n\n.enterpriseTree {\n  max-height: 590px;\n  overflow: auto;\n  padding: 4px 0;\n}\n\n.enterpriseTreeRow {\n  display: flex;\n  align-items: stretch;\n  min-width: 0;\n  border-radius: 7px;\n}\n\n.enterpriseTreeRow:hover,\n.enterpriseTreeRow.selected {\n  background: #eaf6f6;\n}\n\n.enterpriseTreeRow.selected {\n  box-shadow: inset 3px 0 var(--enterprise-teal);\n}\n\n.enterpriseTreeToggle {\n  display: grid;\n  flex: 0 0 25px;\n  width: 25px;\n  padding: 0;\n  place-items: center;\n  border: 0;\n  background: transparent;\n  color: #617581;\n  cursor: pointer;\n}\n\n.enterpriseTreeToggle:disabled {\n  cursor: default;\n}\n\n.enterpriseTreeSelect {\n  display: grid;\n  grid-template-columns: 19px minmax(0, 1fr);\n  flex: 1 1 auto;\n  gap: 8px;\n  align-items: start;\n  min-width: 0;\n  min-height: 48px;\n  width: auto;\n  padding: 7px 9px 7px 2px;\n  border: 0;\n  background: transparent;\n  color: inherit;\n  text-align: left;\n  cursor: pointer;\n  width: 100%;\n}\n\n.enterpriseRecordCode {\n  display: inline-block;\n  color: #173f52;\n  font-family: \"Cascadia Mono\", \"SFMono-Regular\", Consolas, monospace;\n  font-size: 0.72rem;\n  font-weight: 750;\n  white-space: nowrap;\n}\n\n.enterpriseTreeCopy {\n  display: grid;\n  gap: 2px;\n  min-width: 0;\n}\n\n.enterpriseTreeCopy > strong {\n  line-height: 1.18;\n  overflow-wrap: break-word;\n}\n\n.enterpriseTreeSelect small {\n  display: flex;\n  align-items: center;\n  flex-wrap: wrap;\n  gap: 3px 6px;\n  min-width: 0;\n  color: #71848d;\n  font-size: 0.7rem;\n  line-height: 1.25;\n}\n\n.enterpriseTreeSelect small > span {\n  min-width: 0;\n  overflow-wrap: break-word;\n}\n\n.enterpriseTreeSelect em,\n.enterpriseStatus {\n  flex: 0 0 auto;\n  padding: 2px 6px;\n  border-radius: 999px;\n  background: #edf1f3;\n  color: #58707a;\n  font-size: 0.66rem;\n  font-style: normal;\n  font-weight: 800;\n  text-transform: uppercase;\n}\n\n.enterpriseTreeSelect em.active,\n.enterpriseStatus.active {\n  background: #e3f5ea;\n  color: #247049;\n}\n\n.enterpriseTreeSelect em.draft,\n.enterpriseStatus.draft {\n  background: #fff3d8;\n  color: #8e6410;\n}\n\n.enterpriseNodeForm {\n  display: grid;\n  gap: 11px;\n}\n\n.enterpriseNodeForm label {\n  display: grid;\n  gap: 5px;\n}\n\n.enterpriseNodeForm label > span,\n.enterpriseNodeForm legend,\n.enterpriseRelationsGrid strong,\n.categoryItems > strong {\n  color: #526b76;\n  font-size: 0.72rem;\n  font-weight: 800;\n  letter-spacing: 0.04em;\n  text-transform: uppercase;\n}\n\n.enterpriseNodeForm input,\n.enterpriseNodeForm select,\n.enterpriseNodeForm textarea,\n.enterpriseRelationsGrid select,\n.enterpriseFilters input,\n.enterpriseFilters select,\n.newCategoryItem input {\n  width: 100%;\n  min-height: 38px;\n  box-sizing: border-box;\n  padding: 8px 10px;\n  border: 1px solid #c7d4da;\n  border-radius: 6px;\n  background: white;\n  color: #18333f;\n  font: inherit;\n}\n\n.enterpriseNodeForm textarea {\n  min-height: 76px;\n  resize: vertical;\n}\n\n.formColumns {\n  display: grid;\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n  gap: 10px;\n}\n\n.enterpriseRelationsGrid {\n  display: grid;\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n  gap: 10px;\n  margin-top: 15px;\n  padding-top: 14px;\n  border-top: 1px solid #e4ebee;\n}\n\n.enterpriseRelationsGrid form {\n  display: grid;\n  gap: 7px;\n  padding: 11px;\n  border-radius: 8px;\n  background: #f5f8f9;\n}\n\n.enterpriseAssignments {\n  display: grid;\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n  gap: 10px;\n  margin-top: 10px;\n}\n\n.enterpriseAssignments section {\n  display: grid;\n  align-content: start;\n  gap: 6px;\n  padding: 10px;\n  border: 1px solid #dce5e8;\n  border-radius: 8px;\n}\n\n.enterpriseAssignments section > strong {\n  color: #526b76;\n  font-size: 0.7rem;\n  text-transform: uppercase;\n}\n\n.enterpriseAssignments article {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 8px;\n  padding: 5px 7px;\n  border-radius: 5px;\n  background: #f3f7f8;\n  font-size: 0.72rem;\n}\n\n.enterpriseAssignments article button {\n  border: 0;\n  background: transparent;\n  color: #9b302a;\n  font-size: 1rem;\n  cursor: pointer;\n}\n\n.enterpriseAssignments p {\n  margin: 0;\n  color: #71858e;\n  font-size: 0.75rem;\n}\n\n.enterpriseCatalogLayout {\n  grid-template-columns: minmax(330px, 0.85fr) minmax(480px, 1.35fr);\n}\n\n.enterpriseTypeCards {\n  display: grid;\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n  gap: 8px;\n}\n\n.enterpriseTypeCards button,\n.categoryPills button,\n.ruleList button {\n  display: grid;\n  gap: 4px;\n  padding: 12px;\n  border: 1px solid #d4dfe3;\n  border-radius: 8px;\n  background: #f9fbfb;\n  color: inherit;\n  text-align: left;\n}\n\n.enterpriseTypeCards button span,\n.categoryPills small,\n.ruleList span {\n  color: #6c8089;\n  font-size: 0.74rem;\n}\n\n.enterpriseTypeCards em,\n.ruleList em {\n  color: var(--enterprise-teal);\n  font-size: 0.68rem;\n  font-style: normal;\n  font-weight: 800;\n  text-transform: uppercase;\n}\n\n.categoryPills {\n  display: flex;\n  gap: 7px;\n  margin-bottom: 14px;\n  overflow-x: auto;\n}\n\n.categoryPills button {\n  min-width: 130px;\n  cursor: pointer;\n}\n\n.categoryPills button.active,\n.ruleList button.active {\n  border-color: var(--enterprise-teal);\n  background: #eaf7f6;\n  box-shadow: inset 3px 0 var(--enterprise-teal);\n}\n\n.enterpriseNodeForm fieldset {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 7px 14px;\n  margin: 0;\n  padding: 11px;\n  border: 1px solid #d8e2e6;\n  border-radius: 7px;\n}\n\n.enterpriseNodeForm .checkLine {\n  display: flex;\n  flex-direction: row;\n  align-items: center;\n  gap: 6px;\n  color: #344f5b;\n  font-size: 0.78rem;\n  font-weight: 650;\n}\n\n.enterpriseNodeForm .checkLine input {\n  width: 15px;\n  min-height: 15px;\n}\n\n.categoryItems {\n  display: grid;\n  gap: 6px;\n}\n\n.categoryItems > div,\n.newCategoryItem {\n  display: grid;\n  grid-template-columns: minmax(110px, 0.7fr) minmax(160px, 1.3fr) 35px;\n  gap: 6px;\n}\n\n.categoryItems button {\n  border: 1px solid #e0b8b5;\n  border-radius: 6px;\n  background: #fff6f5;\n  color: #9b302a;\n  font-size: 1.1rem;\n}\n\n.newCategoryItem {\n  grid-template-columns: minmax(110px, 0.7fr) minmax(160px, 1.3fr) auto;\n  padding: 9px;\n  border-radius: 7px;\n  background: #f2f6f7;\n}\n\n.enterpriseRulesLayout {\n  grid-template-columns: minmax(250px, 0.55fr) minmax(470px, 1.45fr);\n}\n\n.ruleList {\n  display: grid;\n  gap: 7px;\n}\n\n.ruleList button {\n  position: relative;\n  cursor: pointer;\n}\n\n.ruleList em {\n  position: absolute;\n  top: 10px;\n  right: 10px;\n}\n\n.rootRule {\n  align-self: end;\n  min-height: 38px;\n}\n\n.enterprisePublication {\n  grid-template-columns: minmax(480px, 1.3fr) minmax(290px, 0.7fr);\n}\n\n.publicationSummary > p,\n.validationPanel > p,\n.validationPanel li {\n  color: #526a75;\n  line-height: 1.5;\n}\n\n.publicationSteps {\n  display: grid;\n  grid-template-columns: repeat(3, minmax(0, 1fr));\n  gap: 9px;\n  margin: 18px 0;\n}\n\n.publicationSteps article {\n  display: grid;\n  gap: 7px;\n  min-height: 110px;\n  padding: 13px;\n  border: 1px solid #d6e1e5;\n  border-radius: 8px;\n  background: #f8fafb;\n}\n\n.publicationSteps svg {\n  color: var(--enterprise-teal);\n}\n\n.publicationSteps span {\n  color: #637983;\n  font-size: 0.78rem;\n  line-height: 1.4;\n}\n\n.publicationActions {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 8px;\n}\n\n.validationPanel .issues {\n  color: #952e29;\n}\n\n.validationPanel .warnings {\n  color: #866014;\n}\n\n.validationOk {\n  color: #23714b !important;\n  font-weight: 700;\n}\n\n.revisionManager {\n  display: grid;\n  gap: 14px;\n}\n\n.revisionReleaseStrip {\n  display: grid;\n  grid-template-columns: minmax(250px, 0.8fr) minmax(260px, 0.9fr) minmax(410px, 1.3fr);\n  gap: 10px;\n  align-items: center;\n  padding: 12px 14px;\n  border: 1px solid #cbd9df;\n  border-radius: 9px;\n  background: #f6f9fa;\n}\n\n.revisionReleaseStrip > div:not(.revisionGateActions) {\n  display: grid;\n  gap: 3px;\n}\n\n.revisionReleaseStrip span,\n.revisionStatusBar span {\n  color: var(--enterprise-muted);\n  font-size: 0.7rem;\n  font-weight: 800;\n  letter-spacing: 0.04em;\n  text-transform: uppercase;\n}\n\n.revisionReleaseStrip strong {\n  overflow-wrap: anywhere;\n}\n\n.revisionReleaseStrip em {\n  width: fit-content;\n  padding: 2px 7px;\n  border-radius: 999px;\n  background: #dff3e8;\n  color: #176743;\n  font-size: 0.68rem;\n  font-style: normal;\n  font-weight: 800;\n  text-transform: uppercase;\n}\n\n.revisionReleaseStrip small {\n  color: #647983;\n}\n\n.revisionGateActions,\n.revisionEditorActions,\n.revisionFormActions {\n  display: flex;\n  justify-content: flex-end;\n  flex-wrap: wrap;\n  gap: 7px;\n}\n\n.revisionStatusBar {\n  display: flex;\n  align-items: center;\n  flex-wrap: wrap;\n  gap: 8px 16px;\n  padding: 9px 12px;\n  border: 1px solid #d5e0e4;\n  border-radius: 8px;\n  background: white;\n  font-size: 0.75rem;\n}\n\n.revisionStatusBar code {\n  color: #244b5c;\n}\n\n.revisionWorkspaceGrid {\n  display: grid;\n  grid-template-columns: minmax(340px, 0.8fr) minmax(520px, 1.2fr);\n  gap: 14px;\n  align-items: start;\n}\n\n.revisionTreePanel {\n  min-width: 0;\n}\n\n.revisionTreeRoot,\n.revisionTreeBranch {\n  margin: 0;\n  padding: 0;\n  list-style: none;\n}\n\n.revisionTreeBranch {\n  margin-left: 18px;\n  padding-left: 8px;\n  border-left: 1px dotted #c5d4da;\n}\n\n.revisionTreeRow {\n  display: flex;\n  align-items: stretch;\n  margin: 2px 0;\n  border-radius: 7px;\n}\n\n.revisionTreeRow:hover,\n.revisionTreeRow.selected {\n  background: #eaf6f6;\n}\n\n.revisionTreeRow.selected {\n  box-shadow: inset 3px 0 var(--enterprise-teal);\n}\n\n.revisionTreeToggle {\n  display: grid;\n  flex: 0 0 25px;\n  width: 25px;\n  padding: 0;\n  border: 0;\n  background: transparent;\n  color: #607782;\n  cursor: pointer;\n  place-items: center;\n}\n\n.revisionTreeSelect {\n  display: grid;\n  grid-template-columns: auto minmax(0, 1fr);\n  flex: 1;\n  gap: 2px 8px;\n  min-width: 0;\n  padding: 7px 8px 7px 2px;\n  border: 0;\n  background: transparent;\n  color: inherit;\n  text-align: left;\n  cursor: pointer;\n}\n\n.revisionTreeSelect strong {\n  overflow-wrap: anywhere;\n}\n\n.revisionTreeSelect small {\n  grid-column: 2;\n  color: #6b7f88;\n  font-size: 0.69rem;\n}\n\n.revisionLegend {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 5px;\n  margin: -3px 0 10px;\n}\n\n.revisionState {\n  display: inline-flex;\n  align-items: center;\n  gap: 4px;\n  padding: 2px 6px;\n  border: 1px solid #cfdade;\n  border-radius: 999px;\n  background: #f4f7f8;\n  color: #536a74;\n  font-size: 0.63rem;\n  font-weight: 800;\n  text-transform: uppercase;\n}\n\n.revisionState::before {\n  content: \"●\";\n  font-size: 0.52rem;\n}\n\n.revisionState.add {\n  border-color: #8fcdb1;\n  background: #edf9f2;\n  color: #176743;\n}\n\n.revisionState.modify,\n.revisionState.classification {\n  border-color: #a8c9df;\n  background: #eff6fb;\n  color: #265e84;\n}\n\n.revisionState.move {\n  border-color: #d8c58f;\n  background: #fff9e8;\n  color: #765915;\n}\n\n.revisionState.archive {\n  border-color: #ddb3af;\n  background: #fff4f3;\n  color: #8d312b;\n}\n\n.revisionWorkspaceDetail {\n  display: grid;\n  gap: 9px;\n  margin: 0;\n}\n\n.revisionWorkspaceDetail div {\n  display: grid;\n  grid-template-columns: 130px 1fr;\n  gap: 10px;\n  padding-bottom: 8px;\n  border-bottom: 1px solid #e7edef;\n}\n\n.revisionWorkspaceDetail dt {\n  color: #637984;\n  font-size: 0.72rem;\n  font-weight: 800;\n  text-transform: uppercase;\n}\n\n.revisionWorkspaceDetail dd {\n  margin: 0;\n  overflow-wrap: anywhere;\n  font-size: 0.8rem;\n}\n\n.recordCodePreview {\n  display: grid;\n  gap: 4px;\n  padding: 10px 12px;\n  border-left: 4px solid var(--enterprise-teal);\n  border-radius: 7px;\n  background: #eef8f7;\n  font-family: \"Cascadia Mono\", Consolas, monospace;\n  font-size: 0.75rem;\n}\n\n.recordCodePreview strong {\n  font-family: inherit;\n  text-transform: uppercase;\n}\n\n.revisionClassificationEditor {\n  display: block !important;\n}\n\n.revisionClassificationEditor > div {\n  display: grid;\n  grid-template-columns: minmax(130px, 1fr) minmax(130px, 1fr) auto;\n  gap: 6px;\n  width: 100%;\n  margin-bottom: 8px;\n}\n\n.revisionClassificationEditor select {\n  min-height: 36px;\n  border: 1px solid #c7d4da;\n  border-radius: 6px;\n}\n\n.revisionClassificationTag {\n  margin: 2px 4px 2px 0;\n  padding: 4px 7px;\n  border: 1px solid #aad2cf;\n  border-radius: 999px;\n  background: #edf8f7;\n  color: #245f5d;\n  font-size: 0.7rem;\n  cursor: pointer;\n}\n\n.revisionDiffSummary {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 5px 10px;\n  color: #5d737d;\n  font-size: 0.7rem;\n  text-transform: capitalize;\n}\n\n.revisionEmptyState {\n  display: grid;\n  min-height: 210px;\n  place-content: center;\n  justify-items: center;\n  color: #607680;\n  text-align: center;\n}\n\n.revisionEmptyState h3 {\n  margin: 10px 0 3px;\n  color: var(--enterprise-ink);\n}\n\n.revisionEmptyState p {\n  max-width: 520px;\n  margin: 0;\n}\n\n.userHero {\n  background:\n    radial-gradient(circle at 88% 15%, rgb(46 132 199 / 20%), transparent 32%),\n    linear-gradient(135deg, #f8fbfd 0%, #edf4f8 100%);\n}\n\n.explorerToolbar {\n  display: grid;\n  grid-template-columns: minmax(0, 1fr) auto;\n  gap: 12px;\n  align-items: center;\n}\n\n.enterpriseFilters {\n  display: grid;\n  grid-template-columns: minmax(180px, 1.4fr) repeat(5, minmax(0, 0.8fr));\n  gap: 7px;\n  min-width: 0;\n}\n\n.enterpriseFilters > * {\n  min-width: 0;\n}\n\n.enterpriseSearch {\n  position: relative;\n}\n\n.enterpriseSearch svg {\n  position: absolute;\n  top: 11px;\n  left: 10px;\n  color: #6a7e87;\n}\n\n.enterpriseSearch input {\n  padding-left: 32px;\n}\n\n.viewSwitch {\n  display: flex;\n  gap: 3px;\n  padding: 3px;\n  border: 1px solid #d0dce0;\n  border-radius: 7px;\n  background: #f4f7f8;\n}\n\n.viewSwitch button {\n  min-height: 32px;\n  padding: 6px 9px;\n  font-size: 0.75rem;\n}\n\n.enterpriseExplorerGrid {\n  grid-template-columns: minmax(0, 1.45fr) minmax(260px, 0.55fr);\n}\n\n.explorerResults {\n  min-width: 0;\n}\n\n.resultCount {\n  color: #657b85;\n  font-size: 0.77rem;\n  font-weight: 700;\n}\n\n.enterpriseTableWrap {\n  overflow-x: auto;\n}\n\n.enterpriseTable {\n  width: 100%;\n  border-collapse: collapse;\n  font-size: 0.78rem;\n}\n\n.enterpriseTable th,\n.enterpriseTable td {\n  padding: 10px 9px;\n  border-bottom: 1px solid #e3eaed;\n  text-align: left;\n}\n\n.enterpriseTable th {\n  color: #607681;\n  font-size: 0.67rem;\n  letter-spacing: 0.05em;\n  text-transform: uppercase;\n}\n\n.enterpriseTable tbody tr {\n  cursor: pointer;\n}\n\n.enterpriseTable tbody tr:hover {\n  background: #f0f8f8;\n}\n\n.enterpriseTableAction {\n  padding: 4px 7px;\n  border: 1px solid #b8cbd2;\n  border-radius: 5px;\n  background: white;\n  color: #1d4b5a;\n  font: inherit;\n  font-weight: 750;\n  cursor: pointer;\n}\n\n.enterpriseDetail {\n  position: sticky;\n  top: 16px;\n  overflow: hidden;\n}\n\n.enterpriseDetail.empty {\n  display: grid;\n  min-height: 210px;\n  padding: 20px;\n  place-content: center;\n  gap: 7px;\n  color: #657a84;\n  text-align: center;\n}\n\n.enterpriseBreadcrumb {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 3px;\n  align-items: center;\n  padding: 10px 13px;\n  background: #eef4f6;\n  color: #58717d;\n  font-size: 0.7rem;\n}\n\n.enterpriseDetail header,\n.enterpriseDetail dl,\n.enterpriseDetail section {\n  margin: 0;\n  padding: 14px;\n  border-bottom: 1px solid #e3eaed;\n}\n\n.enterpriseDetail header span,\n.enterpriseDetail h4 {\n  color: #647a84;\n  font-size: 0.69rem;\n  font-weight: 800;\n  letter-spacing: 0.06em;\n  text-transform: uppercase;\n}\n\n.enterpriseDetail header h3 {\n  margin: 4px 0;\n}\n\n.enterpriseDetail dl {\n  display: grid;\n  gap: 8px;\n}\n\n.enterpriseDetail dl div {\n  display: grid;\n  grid-template-columns: 88px 1fr;\n  gap: 8px;\n}\n\n.enterpriseDetail dt {\n  color: #6a7f89;\n  font-size: 0.72rem;\n  font-weight: 750;\n}\n\n.enterpriseDetail dd {\n  margin: 0;\n  font-size: 0.78rem;\n  line-height: 1.4;\n}\n\n.enterpriseDetail h4 {\n  display: flex;\n  align-items: center;\n  gap: 6px;\n  margin: 0 0 9px;\n}\n\n.enterpriseDetail section p {\n  margin: 0;\n  color: #72858d;\n  font-size: 0.76rem;\n}\n\n.enterpriseTag {\n  display: inline-flex;\n  margin: 0 5px 5px 0;\n  padding: 4px 7px;\n  border-radius: 999px;\n  background: #e7f5f4;\n  color: #1b6665;\n  font-size: 0.69rem;\n  font-weight: 700;\n}\n\n.enterpriseDetail section article {\n  display: flex;\n  justify-content: space-between;\n  gap: 8px;\n  padding: 6px 0;\n  font-size: 0.73rem;\n}\n\n.enterpriseExplorerFooter {\n  display: flex;\n  align-items: center;\n  justify-content: flex-end;\n  gap: 7px;\n  color: #637a85;\n  font-size: 0.75rem;\n}\n\n.spin {\n  animation: enterprise-spin 0.8s linear infinite;\n}\n\n@keyframes enterprise-spin {\n  to {\n    transform: rotate(360deg);\n  }\n}\n\n.projectCreationActions,\n.projectCreationHeader,\n.projectListToolbar,\n.projectFormActions,\n.projectPreviewPanel > header,\n.projectRequestCard > header,\n.projectRequestCard > footer,\n.projectOverviewCard > header {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n}\n\n.projectCreationActions {\n  flex-wrap: wrap;\n  padding: 10px 12px;\n  border: 1px solid #d7e1e5;\n  border-radius: 10px;\n  background: #fff;\n}\n\n.physicalTypePicker {\n  display: grid;\n  grid-template-columns: repeat(3, minmax(0, 1fr));\n  gap: 10px;\n  margin: 0 0 14px;\n}\n\n.physicalTypePicker button {\n  align-items: center;\n  background: #fff;\n  border: 1px solid #cbd8df;\n  border-radius: 10px;\n  color: #172b38;\n  display: flex;\n  gap: 10px;\n  justify-content: flex-start;\n  min-height: 64px;\n  padding: 10px 14px;\n  text-align: left;\n}\n\n.physicalTypePicker button.active {\n  background: #eaf8f7;\n  border-color: #159b93;\n  box-shadow: inset 3px 0 #159b93;\n}\n\n.physicalTypePicker button span {\n  display: grid;\n  gap: 2px;\n}\n.physicalTypePicker button small {\n  color: #617581;\n  font-size: 0.72rem;\n}\n.dynamicPhysicalAttributes label {\n  text-transform: none;\n}\n\n.physicalAttributeSummary {\n  display: grid;\n  grid-template-columns: repeat(3, minmax(0, 1fr));\n  gap: 8px;\n}\n\n.physicalAttributeSummary div {\n  background: #f4f8fa;\n  border: 1px solid #dce5ea;\n  border-radius: 8px;\n  padding: 9px 11px;\n}\n\n.physicalAttributeSummary dt {\n  color: #617581;\n  font-size: 0.72rem;\n  text-transform: capitalize;\n}\n.physicalAttributeSummary dd {\n  margin: 4px 0 0;\n  font-weight: 700;\n}\n\n.physicalRequestFilters {\n  display: grid;\n  grid-template-columns: repeat(4, minmax(150px, 1fr));\n  gap: 0.55rem;\n  padding: 0.75rem;\n  border-bottom: 1px solid #d7e1e5;\n  background: #f8fafc;\n}\n\n.physicalRequestFilters input,\n.physicalRequestFilters select {\n  min-width: 0;\n  padding: 0.55rem 0.65rem;\n  border: 1px solid #cbd8df;\n  border-radius: 8px;\n  background: #fff;\n}\n\n@media (max-width: 760px) {\n  .physicalTypePicker,\n  .physicalAttributeSummary {\n    grid-template-columns: 1fr;\n  }\n\n  .physicalRequestFilters {\n    grid-template-columns: 1fr;\n  }\n}\n\n.projectCreationActions button,\n.projectCreationWorkspace button,\n.projectIntakeForm button {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: 6px;\n  min-height: 34px;\n  padding: 7px 12px;\n  border: 1px solid #102a3a;\n  border-radius: 7px;\n  background: #102a3a;\n  color: #fff;\n  font: inherit;\n  font-size: 0.76rem;\n  font-weight: 750;\n  cursor: pointer;\n}\n\n.projectCreationActions button.ghost,\n.projectCreationWorkspace button.ghost {\n  border-color: #cbd8dd;\n  background: #fff;\n  color: #25404d;\n}\n\n.projectCreationActions button.contextual {\n  margin-left: auto;\n  border-color: #0d8f8b;\n  background: #e7f6f5;\n  color: #126d6a;\n}\n\n.projectCreationWorkspace {\n  display: grid;\n  gap: 14px;\n  color: #102532;\n}\n\n.projectCreationHeader {\n  justify-content: space-between;\n  padding: 12px 16px;\n  border: 1px solid #cad8de;\n  border-radius: 10px;\n  background: linear-gradient(110deg, #fff, #eff8f7);\n}\n\n.projectCreationHeader > div {\n  flex: 1;\n}\n\n.projectCreationHeader span,\n.projectPreviewPanel header span,\n.projectOverviewCard header span {\n  color: #657b86;\n  font-size: 0.67rem;\n  font-weight: 800;\n  letter-spacing: 0.06em;\n}\n\n.projectCreationHeader h2,\n.projectPreviewPanel h3,\n.projectOverviewCard h2 {\n  margin: 2px 0 0;\n}\n\n.governedBadge {\n  display: inline-flex;\n  align-items: center;\n  gap: 5px;\n  padding: 6px 9px;\n  border-radius: 999px;\n  background: #daf2ec;\n  color: #17654f !important;\n}\n\n.projectIntakeForm,\n.projectRequestPanel,\n.projectPreviewPanel,\n.projectOverviewCard,\n.projectBlockedState {\n  display: grid;\n  gap: 14px;\n  padding: 16px;\n  border: 1px solid #d4e0e5;\n  border-radius: 11px;\n  background: #fff;\n}\n\n.projectIntakeSection {\n  display: grid;\n  gap: 12px;\n  padding-bottom: 16px;\n  border-bottom: 1px solid #e1e9ec;\n}\n\n.projectIntakeSection > header {\n  display: flex;\n  align-items: flex-start;\n  gap: 10px;\n}\n\n.projectIntakeSection > header > span {\n  display: grid;\n  width: 25px;\n  height: 25px;\n  place-items: center;\n  border-radius: 50%;\n  background: #102a3a;\n  color: #fff;\n  font-size: 0.72rem;\n  font-weight: 800;\n}\n\n.projectIntakeSection h3,\n.projectIntakeSection p {\n  margin: 0;\n}\n\n.governanceModelOptions {\n  display: grid;\n  grid-template-columns: repeat(3, minmax(170px, 1fr));\n  gap: 9px;\n}\n\n.governanceModelOptions label {\n  display: flex;\n  align-items: center;\n  gap: 9px;\n  min-height: 58px;\n  padding: 10px 12px;\n  border: 1px solid #d7e1e5;\n  border-radius: 9px;\n  background: #f8fafb;\n  cursor: pointer;\n}\n\n.governanceModelOptions label.selected {\n  border-color: #0d8f8b;\n  background: #eaf7f6;\n  box-shadow: inset 3px 0 #0d8f8b;\n}\n\n.governanceModelOptions label span {\n  display: grid;\n  gap: 3px;\n}\n\n.governanceModelOptions label small {\n  color: #687e88;\n  font-size: 0.68rem;\n}\n\n.governanceRouteNotice {\n  display: flex;\n  align-items: center;\n  gap: 9px;\n  padding: 11px 12px;\n  border: 1px solid #9ed8cf;\n  border-radius: 8px;\n  background: #edf9f6;\n  color: #145e4d;\n  font-size: 0.76rem;\n}\n\n.sourceContextPanel {\n  padding: 14px;\n  border: 1px solid #cbdde3;\n  border-radius: 9px;\n  background: #f8fbfc;\n}\n\n.projectFormGrid label.projectBooleanField {\n  display: flex;\n  align-items: center;\n  align-self: end;\n  min-height: 36px;\n  padding: 7px 9px;\n  border: 1px solid #cbd8de;\n  border-radius: 7px;\n  background: #fff;\n}\n\n.projectFormGrid label.projectBooleanField input {\n  width: auto;\n  min-height: auto;\n}\n\n.projectIntakeSection p {\n  margin-top: 3px;\n  color: #687e88;\n  font-size: 0.74rem;\n}\n\n.projectLocationTree {\n  max-height: 260px;\n  overflow: auto;\n  border: 1px solid #d7e1e5;\n  border-radius: 8px;\n}\n\n.projectLocationTree label {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  min-height: 44px;\n  padding-top: 6px;\n  padding-right: 10px;\n  padding-bottom: 6px;\n  border-bottom: 1px solid #edf2f4;\n  cursor: pointer;\n}\n\n.projectLocationTree label.selected {\n  background: #eaf7f6;\n  box-shadow: inset 3px 0 #0d8f8b;\n}\n\n.projectLocationTree label span,\n.objectivePicker label span {\n  display: grid;\n  gap: 2px;\n}\n\n.projectLocationTree small,\n.objectivePicker small {\n  color: #71848c;\n  font-size: 0.68rem;\n}\n\n.selectedPath {\n  padding: 7px 9px;\n  border-radius: 6px;\n  background: #f2f7f8;\n}\n\n.projectFormGrid {\n  display: grid;\n  grid-template-columns: repeat(2, minmax(180px, 1fr));\n  gap: 11px;\n}\n\n.projectFormGrid label,\n.objectivePicker label {\n  display: grid;\n  gap: 5px;\n  color: #415965;\n  font-size: 0.72rem;\n  font-weight: 750;\n}\n\n.projectFormGrid label.wide {\n  grid-column: 1 / -1;\n}\n\n.projectFormGrid input,\n.projectFormGrid select,\n.projectFormGrid textarea {\n  width: 100%;\n  min-height: 36px;\n  padding: 7px 9px;\n  border: 1px solid #cbd8de;\n  border-radius: 7px;\n  background: #fff;\n  color: #122b37;\n  font: inherit;\n  font-weight: 500;\n  box-sizing: border-box;\n}\n\n.objectivePicker {\n  display: grid;\n  grid-template-columns: repeat(3, minmax(160px, 1fr));\n  gap: 8px;\n}\n\n.objectivePicker label {\n  display: flex;\n  align-items: center;\n  padding: 9px;\n  border: 1px solid #d7e1e5;\n  border-radius: 7px;\n}\n\n.projectFormActions {\n  justify-content: space-between;\n}\n\n.projectFormActions p,\n.projectPreviewPanel footer p {\n  display: flex;\n  align-items: center;\n  gap: 6px;\n  margin: 0;\n  color: #5c727d;\n  font-size: 0.73rem;\n}\n\n.projectBlockedState {\n  justify-items: center;\n  padding: 42px;\n  text-align: center;\n}\n\n.projectBlockedState svg {\n  color: #bc6c09;\n}\n\n.projectBlockedState h3,\n.projectBlockedState p {\n  margin: 0;\n}\n\n.projectBlockedState p {\n  max-width: 620px;\n  color: #6b7e87;\n}\n\n.projectPreviewPanel > header,\n.projectOverviewCard > header,\n.projectRequestCard > header {\n  justify-content: space-between;\n}\n\n.previewNotice {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  padding: 9px 11px;\n  border: 1px solid #b9d7e6;\n  border-radius: 7px;\n  background: #eff8fc;\n  color: #325f74;\n  font-size: 0.75rem;\n}\n\n.projectPreviewGrid,\n.projectOverviewGrid {\n  display: grid;\n  grid-template-columns: repeat(4, minmax(130px, 1fr));\n  gap: 9px;\n}\n\n.projectPreviewGrid > div,\n.projectOverviewGrid > div {\n  display: grid;\n  gap: 4px;\n  padding: 11px;\n  border: 1px solid #dce5e8;\n  border-radius: 8px;\n  background: #f8fafb;\n}\n\n.projectPreviewGrid span,\n.projectOverviewGrid span,\n.projectRequestCard dt {\n  color: #687e87;\n  font-size: 0.67rem;\n  font-weight: 750;\n}\n\n.projectRequestList {\n  display: grid;\n  grid-template-columns: repeat(2, minmax(280px, 1fr));\n  gap: 10px;\n}\n\n.projectListToolbar {\n  justify-content: space-between;\n}\n\n.projectListToolbar > div {\n  display: flex;\n  align-items: center;\n  gap: 7px;\n}\n\n.projectRequestCard {\n  display: grid;\n  gap: 10px;\n  padding: 13px;\n  border: 1px solid #dae4e7;\n  border-radius: 9px;\n  background: #fbfcfc;\n}\n\n.projectRequestCard h3 {\n  margin: 3px 0 0;\n  font-size: 0.94rem;\n}\n\n.projectRequestCard dl {\n  display: grid;\n  grid-template-columns: 1fr 1fr;\n  gap: 7px;\n  margin: 0;\n}\n\n.projectRequestCard dl div {\n  display: grid;\n  gap: 2px;\n}\n\n.projectRequestCard dd {\n  margin: 0;\n  font-size: 0.75rem;\n}\n\n.projectRequestCard > footer {\n  flex-wrap: wrap;\n}\n\n.projectCreationWorkspace button.danger {\n  border-color: #b64b4b;\n  background: #fff1f1;\n  color: #9a3131;\n}\n\n.requestState {\n  padding: 5px 8px;\n  border-radius: 999px;\n  background: #eaf0f3;\n  color: #405d69 !important;\n  font-size: 0.67rem;\n  font-weight: 800;\n  text-transform: uppercase;\n}\n\n.requestState.approved,\n.requestState.created {\n  background: #dcf3e6;\n  color: #246b49 !important;\n}\n\n.requestState.returned,\n.requestState.failed {\n  background: #fff1d9;\n  color: #96600c !important;\n}\n\n.requestState.rejected,\n.requestState.cancelled {\n  background: #fbe4e4;\n  color: #9a3f3f !important;\n}\n\n.requestDecision,\n.requestCreatedNumber {\n  margin: 0;\n  padding: 7px;\n  border-radius: 6px;\n  background: #f3f7f8;\n  font-size: 0.72rem;\n}\n\n.requestCreatedNumber {\n  display: flex;\n  align-items: center;\n  gap: 6px;\n  color: #216348;\n}\n\n.projectRequestEmpty {\n  padding: 34px;\n  border: 1px dashed #c8d6dc;\n  border-radius: 9px;\n  color: #6b7f88;\n  text-align: center;\n}\n\n.projectOverviewCard > header > strong {\n  padding: 6px 10px;\n  border-radius: 999px;\n  background: #fff0d3;\n  color: #8c5b0f;\n  text-transform: uppercase;\n}\n\n.projectOverviewCard section h3 {\n  margin: 0 0 8px;\n  font-size: 0.8rem;\n}\n\n.projectTagRow {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 6px;\n}\n\n.projectTagRow span {\n  padding: 5px 8px;\n  border-radius: 999px;\n  background: #e6f5f4;\n  color: #176a68;\n  font-size: 0.7rem;\n  font-weight: 750;\n}\n\n.enterpriseAlert.error {\n  display: flex;\n  align-items: center;\n  gap: 7px;\n}\n\n.projectCreationWorkspace button:disabled,\n.projectIntakeForm button:disabled {\n  cursor: not-allowed;\n  opacity: 0.55;\n}\n\n@media (max-width: 1400px) {\n  .enterpriseHero,\n  .explorerToolbar {\n    align-items: stretch;\n    flex-direction: column;\n  }\n\n  .enterpriseHero {\n    display: grid;\n  }\n\n  .enterpriseKpis {\n    min-width: 0;\n  }\n\n  .enterpriseFilters {\n    grid-template-columns: repeat(3, minmax(150px, 1fr));\n  }\n\n  .explorerToolbar {\n    grid-template-columns: 1fr;\n  }\n}\n\n@media (max-width: 900px) {\n  .compactModuleHeader {\n    grid-template-columns: 1fr;\n  }\n\n  .compactModuleHeader p {\n    overflow: visible;\n    text-overflow: clip;\n    white-space: normal;\n  }\n\n  .compactModuleHeader h2 {\n    overflow: visible;\n    text-overflow: clip;\n    white-space: normal;\n  }\n\n  .compactHeaderSide {\n    justify-content: space-between;\n  }\n\n  .enterpriseAdminGrid,\n  .enterpriseCatalogLayout,\n  .enterpriseRulesLayout,\n  .enterprisePublication,\n  .enterpriseExplorerGrid {\n    grid-template-columns: 1fr;\n  }\n\n  .projectFormGrid,\n  .objectivePicker,\n  .projectPreviewGrid,\n  .projectOverviewGrid,\n  .projectRequestList {\n    grid-template-columns: 1fr;\n  }\n\n  .projectCreationHeader,\n  .projectFormActions {\n    align-items: stretch;\n    flex-direction: column;\n  }\n\n  .revisionReleaseStrip,\n  .revisionWorkspaceGrid {\n    grid-template-columns: 1fr;\n  }\n\n  .revisionGateActions {\n    justify-content: flex-start;\n  }\n\n  .enterpriseDetail {\n    position: static;\n  }\n}\n\n@media (max-width: 620px) {\n  .compactModuleHeader {\n    padding: 12px;\n  }\n\n  .compactHeaderSide,\n  .compactHeaderMetrics {\n    align-items: stretch;\n  }\n\n  .compactHeaderMetrics {\n    flex-wrap: wrap;\n  }\n\n  .compactHeaderActions {\n    width: 100%;\n  }\n\n  .compactHeaderActions .enterpriseButton {\n    width: 100%;\n  }\n\n  .enterpriseHero {\n    padding: 17px;\n  }\n\n  .enterpriseKpis,\n  .enterpriseFilters,\n  .formColumns,\n  .enterpriseRelationsGrid,\n  .enterpriseAssignments,\n  .enterpriseTypeCards,\n  .publicationSteps {\n    grid-template-columns: 1fr;\n  }\n\n  .categoryItems > div,\n  .newCategoryItem {\n    grid-template-columns: 1fr;\n  }\n\n  .revisionClassificationEditor > div,\n  .revisionWorkspaceDetail div {\n    grid-template-columns: 1fr;\n  }\n}\n.projectConfigurationWorkspace {\n  display: grid;\n  gap: 14px;\n}\n\n.projectGateStrip {\n  align-items: center;\n  background: #eaf7f2;\n  border: 1px solid #9bd5c2;\n  border-left: 4px solid #148566;\n  border-radius: 10px;\n  color: #123b31;\n  display: grid;\n  gap: 12px;\n  grid-template-columns: auto 1fr auto;\n  padding: 14px 16px;\n}\n\n.projectGateStrip div {\n  display: grid;\n  gap: 3px;\n}\n.projectGateStrip em {\n  color: #397064;\n  font-size: 12px;\n  font-style: normal;\n}\n\n.projectSummaryGrid {\n  display: grid;\n  gap: 12px;\n  grid-template-columns: repeat(4, minmax(0, 1fr));\n}\n\n.projectSummaryGrid article {\n  background: #fff;\n  border: 1px 