;\n  display: flex;\n  gap: 10px;\n}\n\n.baRecommendation > svg {\n  color: #008f8a;\n  margin-top: 4px;\n}\n\n.baRecommendation div {\n  display: grid;\n  gap: 4px;\n}\n\n.baRecommendation p {\n  margin: 0;\n}\n\n.baReadiness {\n  display: flex;\n  gap: 12px;\n  justify-content: space-between;\n}\n\n.baReadiness > div {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 6px;\n}\n\n.baReadiness > div:first-child {\n  display: grid;\n}\n\n.baReadiness > div:last-child span {\n  background: #fff0da;\n  border-radius: 4px;\n  color: #8c5200;\n  padding: 4px 7px;\n}\n\n.baActions {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 7px;\n  margin-top: 16px;\n}\n\n.baLinkButton {\n  background: #e4f4f3;\n  color: #006f72;\n  text-decoration: none;\n}\n\n.baHistory header,\n.baHistory p {\n  align-items: center;\n  display: flex;\n  gap: 8px;\n  justify-content: space-between;\n}\n\n.baAdminGrid {\n  display: grid;\n  gap: 10px;\n  grid-template-columns: repeat(3, minmax(0, 1fr));\n}\n\n.baAdminGrid > article {\n  background: white;\n  border: 1px solid #d5dfe4;\n  border-radius: 8px;\n  display: grid;\n  gap: 7px;\n  padding: 14px;\n}\n\n.baAdminGrid h3,\n.baAdminGrid p {\n  margin: 0;\n}\n\n.baAdminGrid footer {\n  align-items: center;\n  display: flex;\n  justify-content: space-between;\n}\n\n.baAdminGrid footer strong {\n  align-items: center;\n  display: inline-flex;\n  gap: 5px;\n}\n\n.baConfigPreview {\n  align-items: end;\n  background: white;\n  border: 1px solid #d5dfe4;\n  border-radius: 8px;\n  display: grid;\n  gap: 12px;\n  grid-template-columns: minmax(260px, 1fr) 180px auto auto;\n  padding: 14px;\n}\n\n.baConfigPreview > div,\n.baConfigPreview output {\n  align-items: flex-start;\n  display: flex;\n  gap: 8px;\n}\n\n.baConfigPreview p,\n.baBoundary {\n  margin: 3px 0 0;\n}\n\n.baConfigPreview label,\n.baConfigPreview output {\n  display: grid;\n  gap: 4px;\n}\n\n.baBoundary {\n  border-top: 1px solid #d5dfe4;\n  padding-top: 12px;\n}\n\n.baStructuredEditor {\n  dis