n.uploadButton {\n  align-items: center;\n  background: #17212b;\n  border: 0;\n  border-radius: 8px;\n  color: #ffffff;\n  cursor: pointer;\n  display: inline-flex;\n  flex: 0 0 auto;\n  font-size: 13px;\n  font-weight: 700;\n  gap: 8px;\n  min-height: 40px;\n  padding: 0 14px;\n}\n\n.uploadButton input {\n  display: none;\n}\n\n.uploadButton.disabled {\n  cursor: progress;\n  opacity: 0.7;\n}\n\n.gateIntro strong,\n.gateFacts strong {\n  display: block;\n}\n\n.gateIntro span,\n.gateFacts span,\n.scheduleGate p {\n  color: #667481;\n  font-size: 13px;\n}\n\n.scheduleIntakeModule {\n  margin: 0;\n  max-width: none;\n}\n\n.gateFacts {\n  display: grid;\n  gap: 10px;\n  grid-template-columns: 1.2fr 1.6fr 1fr 0.8fr 1fr;\n}\n\n.gateFacts div {\n  background: #f8fafb;\n  border: 1px solid #e4e8ec;\n  border-radius: 8px;\n  min-width: 0;\n  padding: 10px;\n}\n\n.gateFacts strong {\n  font-size: 14px;\n  margin-top: 4px;\n  overflow-wrap: anywhere;\n}\n\n.uploadMessage {\n  border-radius: 8px;\n  font-weight: 700;\n  padding: 10px 12px;\n}\n\n.uploadMessage.success {\n  background: #eaf8f2;\n  color: #13745a;\n}\n\n.uploadMessage.error {\n  background: #fff0ee;\n  color: #a42626;\n}\n\n.workspaceAdmin,\n.phaseTwoGrid {\n  display: grid;\n  gap: 16px;\n  margin: 0 auto 16px;\n  max-width: 1480px;\n  width: 100%;\n}\n\n.workspaceAdmin {\n  grid-template-columns: minmax(230px, 0.95fr) minmax(220px, 0.85fr) minmax(220px, 0.85fr) minmax(320px, 1.35fr);\n  order: 3;\n}\n\n.flowSetup {\n  align-items: stretch;\n  grid-template-columns: minmax(280px, 0.9fr) minmax(0, 1.6fr);\n  order: 3;\n}\n\n.flowSetup .adminPanel,\n.flowSetup .scheduleGate {\n  margin: 0;\n  max-width: none;\n  width: 100%;\n}\n\n.flowSetup .scheduleGate {\n  min-width: 0;\n}\n\n.phaseTwoGrid {\n  grid-template-columns: repeat(4, minmax(0, 1fr));\n  order: 9;\n}\n\n.adminPanel {\n  display: grid;\n  gap: 10px;\n  min-height: 260px;\n  padding: 18px;\n}\n\n.bpDesignerPanel {\n  min-height: 520px;\n}\n\n.permissionStrip {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 6px;\n}\n\n.permissionStrip span {\n  background: #edf7f7;\n  border: 1px solid #b9dcdb;\n  border-radius: 999px;\n  color: #0b6f71;\n  font-size: 11px;\n  font-weight: 800;\n  padding: 4px 8px;\n  text-transform: uppercase;\n}\n\n.workflowShell {\n  display: grid;\n  gap: 16px;\n  grid-template-columns: 240px minmax(0, 1fr) 280px;\n  margin: 0 auto 16px;\n  max-width: 1480px;\n  order: 6;\n  width: 100%;\n}\n\n.processRail,\n.workflowCanvas,\n.routingPanel {\n  background: #ffffff;\n  border: 1px solid #d8dee5;\n  border-radius: 8px;\n  box-shadow: 0 14px 30px rgba(23, 33, 43, 0.05);\n}\n\n.processRail {\n  padding: 12px;\n}\n\n.railHeader {\n  border-bottom: 1px solid #edf1f4;\n  margin: -12px -12px 10px;\n  padding: 14px 12px;\n}\n\n.railHeader span,\n.workflowHeader span,\n.workflowMeta span,\n.routingPanel span,\n.registryHeader span {\n  color: #667481;\n  display: block;\n  font-size: 12px;\n  font-weight: 800;\n  margin-bottom: 4px;\n  text-transform: uppercase;\n}\n\n.railHeader strong,\n.workflowMeta strong,\n.routingPanel strong {\n  display: block;\n  font-size: 14px;\n}\n\n.railItem {\n  align-items: center;\n  background: transparent;\n  border: 1px solid transparent;\n  border-radius: 8px;\n  color: #17212b;\n  cursor: pointer;\n  display: flex;\n  justify-content: space-between;\n  margin-bottom: 6px;\n  min-height: 42px;\n  padding: 0 10px;\n  text-align: left;\n  width: 100%;\n}\n\n.railItem span {\n  font-size: 13px;\n  font-weight: 700;\n}\n\n.railItem strong {\n  color: #667481;\n  font-size: 11px;\n  text-transform: uppercase;\n}\n\n.railItem.active {\n  background: #edf7f7;\n  border-color: #b9dcdb;\n}\n\n.workflowCanvas {\n  overflow: auto;\n  scrollbar-gutter: stable;\n}\n\n.workflowHeader,\n.registryHeader {\n  align-items: center;\n  border-bottom: 1px solid #edf1f4;\n  display: flex;\n  justify-content: space-between;\n  padding: 14px 18px;\n}\n\n.workflowHeader h2,\n.registryHeader h2 {\n  font-size: 16px;\n}\n\n.workflowMeta {\n  background: #f8fafb;\n  border: 1px solid #e4e8ec;\n  border-radius: 8px;\n  min-width: 130px;\n  padding: 9px 10px;\n}\n\n.stageTrack {\n  align-items: stretch;\n  display: grid;\n  gap: 8px;\n  grid-template-columns: repeat(9, auto);\n  overflow-x: auto;\n  padding: 18px;\n}\n\n.stageCard {\n  border: 1px solid #d8dee5;\n  border-top: 4px solid #8a98a5;\n  border-radius: 8px;\n  min-width: 190px;\n  padding: 12px;\n}\n\n.stageCard span,\n.statusPill {\n  border-radius: 999px;\n  display: inline-flex;\n  font-size: 11px;\n  font-weight: 800;\n  margin-bottom: 10px;\n  padding: 4px 8px;\n  text-transform: uppercase;\n}\n\n.stageCard strong {\n  display: block;\n  font-size: 14px;\n  margin-bottom: 6px;\n}\n\n.stageCard p,\n.stageCard small,\n.routingPanel p {\n  color: #667481;\n  display: block;\n  font-size: 12px;\n  line-height: 1.45;\n}\n\n.stageCard.complete {\n  border-top-color: #1a9b73;\n}\n\n.stageCard.active {\n  border-top-color: #0f8b8d;\n}\n\n.stageCard.pending {\n  border-top-color: #d39214;\n}\n\n.stageCard.queued {\n  border-top-color: #8a98a5;\n}\n\n.stageCard.critical {\n  border-top-color: #c93636;\n}\n\n.stageCard.complete span,\n.statusPill.complete {\n  background: #eaf8f2;\n  color: #13745a;\n}\n\n.stageCard.active span,\n.statusPill.active {\n  background: #edf7f7;\n  color: #0b6f71;\n}\n\n.stageCard.pending span,\n.statusPill.pending,\n.statusPill.amber {\n  background: #fff7df;\n  color: #8b5d04;\n}\n\n.stageCard.queued span {\n  background: #eef2f4;\n  color: #52616f;\n}\n\n.statusPill.queued {\n  background: #eef2f4;\n  color: #52616f;\n}\n\n.stageCard.critical span,\n.statusPill.critical,\n.statusPill.red {\n  background: #fff0ee;\n  color: #a42626;\n}\n\n.stageArrow {\n  align-self: center;\n  color: #8a98a5;\n}\n\n.recordRegistry {\n  border-top: 1px solid #edf1f4;\n  overflow-x: auto;\n}\n\n.recordRegistry table {\n  min-width: 860px;\n}\n\n.routingPanel {\n  display: grid;\n  gap: 0;\