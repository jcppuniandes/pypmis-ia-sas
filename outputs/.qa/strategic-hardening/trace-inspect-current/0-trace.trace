ojectTemplateForm > label span,\n.projectPreviewControls label span {\n  color: #566877;\n  font-size: 12px;\n  font-weight: 700;\n}\n.projectTemplateForm .wide {\n  grid-column: 1 / -1;\n}\n.projectTemplateForm fieldset {\n  border: 1px solid #dce4e8;\n  border-radius: 8px;\n  display: grid;\n  gap: 8px;\n  padding: 12px;\n}\n.projectTemplateForm fieldset label {\n  align-items: center;\n  display: flex;\n  gap: 6px;\n}\n\n.projectPreviewPanel header,\n.projectFocusedPanel header {\n  align-items: center;\n  display: flex;\n  justify-content: space-between;\n}\n.projectPreviewControls {\n  align-items: end;\n  display: grid;\n  gap: 12px;\n  grid-template-columns: repeat(2, minmax(0, 1fr)) auto;\n}\n.projectPreviewResult {\n  border-left: 4px solid #b46b00;\n  display: grid;\n  gap: 10px;\n  grid-template-columns: repeat(4, minmax(0, 1fr));\n  margin-top: 16px;\n  padding: 12px;\n}\n.projectPreviewResult.allowed {\n  background: #edf8f3;\n  border-color: #16835e;\n}\n.projectPreviewResult.blocked {\n  background: #fff6e8;\n}\n.projectPreviewResult article {\n  display: grid;\n  gap: 4px;\n}\n.projectPreviewResult span {\n  color: #687984;\n  font-size: 11px;\n  text-transform: uppercase;\n}\n.projectPreviewResult p,\n.projectPreviewResult ul {\n  grid-column: 1 / -1;\n  margin: 0;\n}\n\n.projectFocusedPanel {\n  margin: 0 auto;\n  max-width: 980px;\n  width: 100%;\n}\n.projectNumberExample {\n  background: #0f2432;\n  border-radius: 10px;\n  color: #fff;\n  font-size: 32px;\n  font-weight: 800;\n  letter-spacing: 2px;\n  margin: 18px 0;\n  padding: 22px;\n  text-align: center;\n}\n.projectPolicyGrid {\n  display: grid;\n  gap: 10px;\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n  margin: 18px 0;\n}\n.projectPolicyGrid label {\n  align-items: center;\n  background: #f5f8f9;\n  border: 1px solid #dfe6e9;\n  border-radius: 8px;\n  display: flex;\n  gap: 9px;\n  padding: 12px;\n}\n\n.governancePolicyPanel {\n  margin-top: 14px;\n}\n\n.governancePolicyTabs {\n  display: grid;\n  grid-template-columns: repeat(3, minmax(0, 1fr));\n  gap: 8px;\n  margin-top: 16px;\n}\n\n.governancePolicyTabs button {\n  display: grid;\n  gap: 3px;\n  padding: 11px;\n  border: 1px solid #d7e1e5;\n  border-radius: 8px;\n  background: #f5f8f9;\n  color: #18313e;\n  font-weight: 800;\n  text-align: left;\n}\n\n.governancePolicyTabs button.active {\n  border-color: #0d8f8b;\n  background: #eaf7f6;\n  color: #12665f;\n}\n\n.governancePolicyTabs small {\n  color: #6a7e87;\n  font-size: 0.67rem;\n}\n\n.governancePolicyFacts {\n  margin-top: 14px;\n}\n\n@media (max-width: 1050px) {\n  .projectSummaryGrid {\n    grid-template-columns: repeat(2, minmax(0, 1fr));\n  }\n  .projectDefinitionGrid,\n  .projectTemplateLayout {\n    grid-template-columns: 1fr;\n  }\n  .governanceModelOptions {\n    grid-template-columns: 1fr;\n  }\n  .governancePolicyTabs {\n    grid-template-columns: 1fr;\n  }\n}\n\n.projectLifecycleWorkspace,\n.projectWorkspaceInventory {\n  display: grid;\n  gap: 14px;\n}\n\n.lifecycleOverview > header,\n.lifecycleChecklist > header,\n.lifecycleModules > header,\n.projectWorkspaceCards article > header {\n  align-items: flex-start;\n  display: flex;\n  justify-content: space-between;\n}\n\n.lifecycleOverview header small {\n  color: #647480;\n  display: block;\n  margin-top: 4px;\n}\n\n.lifecycleStateStack {\n  align-items: flex-end;\n  display: grid;\n  gap: 6px;\n}\n\n.workspaceLifecycleState,\n.workspaceStatus {\n  border-radius: 999px;\n  font-size: 11px;\n  font-weight: 800;\n  padding: 5px 9px;\n  text-transform: uppercase;\n}\n\n.workspaceLifecycleState.not_started,\n.workspaceLifecycleState.not_initialized {\n  background: #edf1f4;\n  color: #536470;\n}\n.workspaceLifecycleState.initializing,\n.workspaceLifecycleState.ready_for_activation,\n.workspaceLifecycleState.initialized {\n  background: #e2f1fb;\n  color: #12618b;\n}\n.workspaceLifecycleState.blocked,\n.workspaceLifecycleState.failed,\n.workspaceLifecycleState.warning {\n  background: #fff0e3;\n  color: #9b4d00;\n}\n.workspaceLifecycleState.activated,\n.workspaceStatus.active {\n  background: #def3e8;\n  color: #126a4b;\n}\n.workspaceStatus.pending {\n  background: #fff2d8;\n  color: #875600;\n}\n\n.initializationProgress {\n  background: #e7edf0;\n  border-radius: 999px;\n  height: 9px;\n  margin: 18px 0 12px;\n  overflow: hidden;\n}\n.initializationProgress span {\n  background: linear-gradient(90deg, #168b91, #25aa79);\n  display: block;\n  height: 100%;\n  transition: width 180ms ease;\n}\n\n.lifecycleMetrics {\n  display: grid;\n  gap: 9px;\n  grid-template-columns: repeat(4, minmax(0, 1fr));\n  margin-bottom: 14px;\n}\n.lifecycleMetrics article {\n  background: #f5f8fa;\n  border: 1px solid #e0e7eb;\n  border-radius: 8px;\n  display: grid;\n  gap: 4px;\n  padding: 11px;\n}\n.lifecycleMetrics span {\n  color: #617380;\n  font-size: 10px;\n  text-transform: uppercase;\n}\n\n.lifecycleActions {\n  align-items: center;\n  border-top: 1px solid #e1e7eb;\n  display: flex;\n  flex-wrap: wrap;\n  gap: 8px;\n  margin-top: 16px;\n  padding-top: 14px;\n}\n.lifecycleActions button,\n.lifecycleBack,\n.projectWorkspaceCards footer button {\n  align-items: center;\n  display: inline-flex;\n  gap: 6px;\n}\n.lifecycleActions .activate {\n  background: #176f51;\n}\n.activatedNotice {\n  align-items: center;\n  color: #176f51;\n  display: inline-flex;\n  font-weight: 750;\n  gap: 6px;\n}\n\n.checklistRows {\n  display: grid;\n  gap: 7px;\n  margin-top: 12px;\n}\n.checklistRows article {\n  align-items: center;\n  border: 1px solid #dde5e9;\n  border-left: 4px solid #17926c;\n  border-radius: 7px;\n  display: grid;\n  gap: 9px;\n  grid-template-columns: auto 1fr auto;\n  padding: 10px 12px;\n}\n.checklistRows article.fail {\n  border-left-color: #c84e38;\n}\n.checklistRows article.warning {\n  border-left-color: #d28b16;\n}\n.checklistRows article.fail .checkStatus {\n  color: #c84e38;\n}\n.checklistRows article.pass .checkStatus {\n  color: #17926c;