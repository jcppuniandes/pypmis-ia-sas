wStep span {\n  color: #07111c;\n  font-size: 13px;\n  font-weight: 900;\n  line-height: 1.25;\n}\n\n.informationFlowStep strong {\n  color: #0b6f71;\n  font-size: 12px;\n  line-height: 1.3;\n  overflow-wrap: anywhere;\n}\n\n.informationFlowStep small {\n  color: #52616f;\n  font-size: 11px;\n  line-height: 1.35;\n}\n\n.moduleGuide {\n  align-items: center;\n  display: grid;\n  gap: 18px;\n  grid-template-columns: minmax(0, 1.15fr) minmax(360px, 0.85fr);\n  margin: 0 auto 16px;\n  max-width: 1480px;\n  padding: 16px 18px;\n  width: 100%;\n}\n\n.moduleGuideIntro span,\n.moduleGuideFacts span {\n  color: #667481;\n  display: block;\n  font-size: 12px;\n  font-weight: 800;\n  text-transform: uppercase;\n}\n\n.moduleGuideTitle {\n  color: #17212b;\n  display: block;\n  font-size: 22px;\n  font-weight: 800;\n  margin: 4px 0 6px;\n}\n\n.moduleGuideIntro p {\n  color: #52616f;\n  line-height: 1.45;\n  margin: 0;\n}\n\n.moduleGuideFacts {\n  display: grid;\n  gap: 10px;\n  grid-template-columns: 0.75fr 1.25fr;\n}\n\n.moduleGuideFacts article {\n  background: #f8fafb;\n  border: 1px solid #e4e8ec;\n  border-radius: 8px;\n  min-width: 0;\n  padding: 12px;\n}\n\n.moduleGuideFacts strong {\n  display: block;\n  font-size: 13px;\n  line-height: 1.35;\n  margin-top: 6px;\n}\n\n.opcGapPanel {\n  display: grid;\n  gap: 16px;\n}\n\n.opcGapPanel > .panelHeader > div {\n  display: grid;\n  gap: 4px;\n}\n\n.opcGapPanel > .panelHeader h2,\n.opcGapPanel .panelHeader h3 {\n  align-items: center;\n  display: inline-flex;\n  gap: 8px;\n  margin: 0;\n}\n\n.opcGapPanel > .panelHeader > div > span {\n  color: #52616f;\n  display: block;\n  font-size: 13px;\n  line-height: 1.4;\n}\n\n.opcGapPanel > .panelHeader strong {\n  color: #0b6f71;\n  font-size: 28px;\n}\n\n.opcGapSummary,\n.opcDataSpine,\n.opcGapRegister,\n.opcNextActions {\n  background: #ffffff;\n  border: 1px solid #d8dee5;\n  border-radius: 8px;\n  box-shadow: 0 12px 26px rgba(23, 33, 43, 0.04);\n  min-width: 0;\n  padding: 16px;\n}