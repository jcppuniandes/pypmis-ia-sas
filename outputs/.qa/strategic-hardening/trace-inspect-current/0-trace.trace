 0;\n  overflow-x: auto;\n  overscroll-behavior-x: contain;\n  padding: 4px 0 0;\n}\n\n.bimRibbonInformationPanel {\n  background: #f7f9fa;\n  max-height: min(72vh, 780px);\n  overflow-y: auto;\n  overscroll-behavior-y: contain;\n  padding: 14px;\n}\n\n.bimRibbonInformationContent,\n.scopeManagerInformation,\n.bimModelInformation {\n  display: grid;\n  gap: 14px;\n  min-width: 0;\n}\n\n.scopeManagerInformation {\n  border-bottom: 1px solid #cfd7de;\n  padding-bottom: 14px;\n}\n\n.bimModelInformation .bimViewerHeader {\n  background: #ffffff;\n  border: 1px solid #d8dee5;\n  border-radius: 8px;\n  margin: 0;\n  padding: 12px 14px;\n}\n\n.bimRibbonInformationPanel .bimCommercialReadiness,\n.bimRibbonInformationPanel .bimViewerHealth,\n.bimRibbonInformationPanel .bimOperationStrip {\n  padding: 0;\n}\n\n.bimRibbonGroup {\n  display: flex;\n  flex: 0 0 auto;\n  flex-direction: column;\n  justify-content: space-between;\n  min-width: 104px;\n  padding: 7px 9px 4px;\n  position: relative;\n}\n\n.bimRibbonGroup + .bimRibbonGroup {\n  border-left: 1px solid #d3d9de;\n}\n\n.bimRibbonActions {\n  align-items: stretch;\n  display: flex;\n  gap: 5px;\n}\n\n.bimRibbonAction {\n  align-items: center;\n  background: transparent;\n  border: 1px solid transparent;\n  border-radius: 2px;\n  color: #17212b;\n  cursor: pointer;\n  display: inline-flex;\n  flex: 0 0 auto;\n  flex-direction: column;\n  font: inherit;\n  gap: 5px;\n  justify-content: center;\n  min-height: 76px;\n  min-width: 70px;\n  padding: 7px 8px;\n  text-align: center;\n}\n\n.bimRibbonUploadAction {\n  overflow: hidden;\n  position: relative;\n}\n\n.bimRibbonUploadAction input {\n  cursor: pointer;\n  height: 100%;\n  inset: 0;\n  opacity: 0;\n  position: absolute;\n  width: 100%;\n}\n\n.bimRibbonUploadAction.disabled {\n  cursor: not-allowed;\n  opacity: 0.48;\n}\n\n.bimRibbonUploadAction.disabled input {\n  cursor: not-allowed;\n}\n\n.bimRibbonAction span {\n  font-size: 11px;\n  font-weight: 750;\n  line-height: 