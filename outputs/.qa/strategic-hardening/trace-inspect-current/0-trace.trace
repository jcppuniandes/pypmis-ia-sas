p: wrap;\n  gap: 8px;\n  margin-top: 12px;\n}\n.portfolioProjectRegister {\n  display: grid;\n  gap: 12px;\n  grid-template-columns: repeat(auto-fit, minmax(310px, 1fr));\n}\n.planningEmpty {\n  align-items: center;\n  background: #f6f9fa;\n  border: 1px dashed #bdcbd3;\n  border-radius: 10px;\n  color: #607681;\n  display: grid;\n  gap: 5px;\n  justify-items: center;\n  min-height: 150px;\n  padding: 20px;\n  text-align: center;\n}\n.planningAdminSections {\n  background: #f5f8fa;\n  border: 1px solid #d8e1e6;\n  border-radius: 9px;\n  display: flex;\n  flex-wrap: wrap;\n  gap: 4px;\n  padding: 5px;\n}\n.planningAdminSections button {\n  background: transparent;\n  border: 0;\n  color: #4c616e;\n  font-size: 11px;\n  font-weight: 800;\n  padding: 8px;\n}\n.planningAdminGrid {\n  display: grid;\n  gap: 14px;\n  grid-template-columns: minmax(220px, 0.28fr) minmax(0, 1fr);\n}\n.planningAdminGrid aside {\n  align-content: start;\n  display: grid;\n  gap: 6px;\n}\n.planningAdminGrid aside button {\n  background: white;\n  border: 1px solid #d8e1e6;\n  border-radius: 8px;\n  display: grid;\n  gap: 4px;\n  padding: 11px;\n  text-align: left;\n}\n.planningAdminGrid aside button.active {\n  background: #eaf7f6;\n  border-color: #159b9d;\n}\n.planningAdminGrid textarea {\n  font-family: Consolas, monospace;\n  margin-top: 10px;\n  resize: vertical;\n}\n@media (max-width: 900px) {\n  .planningGrid,\n  .planningAdminGrid {\n    grid-template-columns: 1fr;\n  }\n  .planningToolbar {\n    align-items: stretch;\n    flex-direction: column;\n  }\n}\n"],["STYLE",{},".portfolioEvaluation {\n  color: #142532;\n  display: grid;\n  gap: 14px;\n}\n.portfolioEvaluation button,\n.portfolioEvaluation input,\n.portfolioEvaluation select,\n.portfolioEvaluation textarea {\n  font: inherit;\n}\n.evaluationQueues {\n  background: #f5f8fa;\n  border: 1px solid #d8e1e6;\n  border-radius: 9px;\n  display: flex;\n  flex-wrap: wrap;\n  gap: 5px;\n  padding: 5px;\n}\n.evaluationQueues button {\n  bac