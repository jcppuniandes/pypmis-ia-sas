  gap: 2px;\n  min-width: 0;\n}\n\n.tenantCommandBar span,\n.tenantCommandBar label span {\n  color: #b9c7d3;\n  font-size: 12px;\n}\n\n.tenantCommandBar strong {\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.tenantCommandEyebrow {\n  color: #8fb1c9 !important;\n  display: block;\n  font-size: 10px !important;\n  font-weight: 900;\n  letter-spacing: 0;\n  text-transform: uppercase;\n}\n\n.tenantCommandProject h1 {\n  color: #ffffff;\n  font-size: 15px;\n  line-height: 1.2;\n  margin: 0;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.tenantCommandBar select {\n  background: #ffffff;\n  border: 1px solid #8aa0b3;\n  border-radius: 6px;\n  color: #17212b;\n  min-height: 36px;\n  padding: 0 10px;\n}\n\n.tenantCommandUser {\n  display: grid;\n  gap: 2px;\n  justify-items: end;\n  min-width: 0;\n}\n\n.tenantCommandUser strong {\n  color: #ffffff;\n  font-size: 13px;\n  font-weight: 900;\n}\n\n.tenantCommandUser small {\n  color: #b9c7d3;\n  font-size: 11px;\n  max-width: 220px;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.iconButton,\n.iconTextButton {\n  align-items: center;\n  border: 1px solid #cfd8df;\n  border-radius: 6px;\n  cursor: pointer;\n  display: inline-flex;\n  gap: 6px;\n  justify-content: center;\n  min-height: 36px;\n  padding: 0 10px;\n}\n\n.iconButton {\n  aspect-ratio: 1;\n  padding: 0;\n  width: 36px;\n}\n\n.tenantCommandBar .iconButton,\n.tenantCommandBar .iconTextButton {\n  background: #24313d;\n  border-color: #3d5060;\n  color: #ffffff;\n}\n\n.dangerButton {\n  border-color: #b94a48;\n  color: #7f1d1d;\n}\n\n.tenantCommandBar .dangerButton {\n  background: #3a2430;\n  border-color: #8a3b45;\n  color: #ffffff;\n}\n\n.dangerButton:disabled,\n.subtleDanger:disabled {\n  cursor: not-allowed;\n  opacity: 0.55;\n}\n\n.projectCreateDrawer {\n  background: #ffffff;\n  border-left: 1px solid #d8dee5;\n  bottom: 0;\n  box-shadow: -18px 0 32px rgba(23, 33, 43, 0.16);\n  display: grid;\n  gap: 14px;\n  max-width: 520px;\n  overflow-y: auto;\n  padding: 18px;\n  position: fixed;\n  right: 0;\n  top: 0;\n  width: min(520px, 94vw);\n  z-index: 50;\n}\n\n.guidedWorkspace {\n  grid-template-columns: 270px minmax(0, 1fr);\n}\n\n.guidedProcessRail,\n.nextActionPanel,\n.costCurrencyGate {\n  background: #ffffff;\n  border: 1px solid #d8dee5;\n  border-radius: 8px;\n  box-shadow: 0 12px 24px rgba(23, 33, 43, 0.05);\n}\n\n.guidedProcessRail {\n  display: grid;\n  gap: 8px;\n  padding: 14px;\n}\n\n.guidedRailItem {\n  align-items: center;\n  background: #f8fafb;\n  border: 1px solid #e2e8ee;\n  border-radius: 8px;\n  color: #17212b;\n  cursor: pointer;\n  display: grid;\n  gap: 8px;\n  grid-template-columns: auto minmax(0, 1fr) auto;\n  padding: 10px;\n  text-align: left;\n}\n\n.guidedRailItem.active {\n  border-color: #0f8b8d;\n  box-shadow: inset 3px 0 0 #0f8b8d;\n}\n\n.guidedRailItem.blocked {\n  background: #fff7ed;\n}\n\n.guidedRailItem.complete {\n  background: #effaf5;\n}\n\n.guidedRailItem small,\n.nextActionPanel p {\n  color: #52616f;\n  display: block;\n  font-size: 12px;\n  line-height: 1.35;\n  margin: 2px 0 0;\n}\n\n.guidedRailItem em {\n  color: #52616f;\n  font-style: normal;\n  font-weight: 800;\n}\n\n.nextActionPanel {\n  align-items: center;\n  display: grid;\n  gap: 10px;\n  grid-template-columns: minmax(0, 1fr) auto;\n  padding: 14px;\n}\n\n.nextActionPanel > span {\n  color: #0f8b8d;\n  font-size: 12px;\n  font-weight: 800;\n  grid-column: 1 / -1;\n  text-transform: uppercase;\n}\n\n.nextActionPanel strong {\n  font-size: 18px;\n}\n\n.nextActionPanel p {\n  justify-self: end;\n  max-width: 360px;\n  margin: 0;\n}\n\n.nextActionPanel .workflowAction {\n  justify-self: start;\n  min-width: 280px;\n}\n\n.costCurrencyGate {\n  align-items: center;\n  display: grid;\n  gap: 12px;\n  grid-template-columns: minmax(180px, 1fr) minmax(360px, 2fr) auto;\n  margin-bottom: 14px;\n  padding: 14px;\n}\n\n.costCurrencyGate