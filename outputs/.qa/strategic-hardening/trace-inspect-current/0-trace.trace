x;\n  justify-content: flex-end;\n}\n\n.contextSwitch {\n  align-items: end;\n  display: grid;\n  gap: 8px;\n  grid-template-columns: 150px 170px auto;\n}\n\n.contextSwitch label {\n  display: grid;\n  gap: 4px;\n}\n\n.contextSwitch label span {\n  color: #667481;\n  font-size: 11px;\n  font-weight: 800;\n  text-transform: uppercase;\n}\n\n.contextSwitch select {\n  background: #ffffff;\n  border: 1px solid #d8dee5;\n  border-radius: 8px;\n  color: #17212b;\n  font: inherit;\n  font-size: 12px;\n  height: 40px;\n  min-width: 0;\n  padding: 0 9px;\n}\n\n.contextSwitch strong {\n  align-items: center;\n  background: #edf7f7;\n  border: 1px solid #b9dcdb;\n  border-radius: 8px;\n  color: #0b6f71;\n  display: inline-flex;\n  font-size: 12px;\n  height: 40px;\n  padding: 0 10px;\n  white-space: nowrap;\n}\n\n.healthBadge {\n  border: 1px solid #d8dee5;\n  border-radius: 8px;\n  min-width: 210px;\n  padding: 10px 12px;\n}\n\n.healthBadge span,\n.controlSummary span {\n  color: #667481;\n  display: block;\n  font-size: 12px;\n  font-weight: 700;\n  margin-bottom: 4px;\n  text-transform: uppercase;\n}\n\n.healthBadge strong,\n.controlSummary strong {\n  display: block;\n  font-size: 14px;\n  overflow-wrap: anywhere;\n}\n\n.healthBadge.critical {\n  background: #fff0ee;\n  border-color: #efb4aa;\n}\n\n.healthBadge.stable {\n  background: #eaf8f2;\n  border-color: #a8d9c8;\n}\n\n.iconButton {\n  align-items: center;\n  background: #1d2d35;\n  border: 0;\n  border-radius: 8px;\n  color: #ffffff;\n  cursor: pointer;\n  display: inline-flex;\n  height: 40px;\n  justify-content: center;\n  width: 40px;\n}\n\n.quickNavButton {\n  align-items: center;\n  background: #ffffff;\n  border: 1px solid #cfd8df;\n  border-radius: 8px;\n  color: #17212b;\n  cursor: pointer;\n  display: inline-flex;\n  font-size: 13px;\n  font-weight: 800;\n  gap: 8px;\n  min-height: 40px;\n  padding: 0 12px;\n  white-space: nowrap;\n}\n\n.quickNavButton.active {\n  background: #edf7f7;\n  border-color: #0f8