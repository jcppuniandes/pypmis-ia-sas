ap: 12px;\n}\n\n.fieldStack {\n  gap: 6px;\n}\n\n.fieldStack label {\n  color: #344450;\n  font-size: 13px;\n  font-weight: 800;\n}\n\n.fieldStack input,\n.loginSubmit {\n  border-radius: 8px;\n  min-height: 44px;\n}\n\n.fieldStack input {\n  border: 1px solid #cfd8df;\n  color: #17212b;\n  font: inherit;\n  padding: 0 12px;\n}\n\n.loginSubmit {\n  background: #17212b;\n  border: 0;\n  color: #ffffff;\n  cursor: pointer;\n  font-size: 14px;\n  font-weight: 800;\n  margin-top: 4px;\n}\n\n.loginSubmit:disabled {\n  cursor: progress;\n  opacity: 0.72;\n}\n\n.loginError {\n  background: #fff0ee;\n  border: 1px solid #ffc8c0;\n  border-radius: 8px;\n  color: #a42626;\n  font-size: 13px;\n  font-weight: 800;\n  padding: 10px 12px;\n}\n\n.productLogo {\n  align-items: center;\n  color: #17212b;\n  display: inline-flex;\n  gap: 12px;\n  min-width: 0;\n}\n\n.productLogo.compact {\n  margin-bottom: 8px;\n}\n\n.productLogoMark {\n  display: block;\n  flex: 0 0 auto;\n  height: 58px;\n  object-fit: contain;\n  width: 58px;\n}\n\n.productLogo.compact .productLogoMark {\n  height: 42px;\n  width: 42px;\n}\n\n.productLogo strong,\n.productLogo span {\n  display: block;\n}\n\n.productLogo strong {\n  font-family: \"Segoe UI\", Arial, sans-serif;\n  font-size: 18px;\n  font-weight: 800;\n  letter-spacing: 0;\n  line-height: 1.1;\n  white-space: nowrap;\n}\n\n.productLogo span {\n  color: #52616f;\n  font-size: 12px;\n  font-weight: 700;\n  letter-spacing: 0;\n  margin-top: 3px;\n}\n\n.appBrandBar {\n  align-items: center;\n  background: #ffffff;\n  border: 1px solid #d8dee5;\n  border-radius: 8px;\n  box-shadow: 0 10px 22px rgba(23, 33, 43, 0.05);\n  color: #344450;\n  display: flex;\n  justify-content: space-between;\n  margin: 0 auto 10px;\n  max-width: 1480px;\n  padding: 10px 16px;\n  width: 100%;\n}\n\n.appBrandBar .productLogo.compact {\n  margin-bottom: 0;\n}\n\n.appBrandBar .productLogo strong {\n  font-size: 19px;\n}\n\n.appBrandBar > span,\n.appBrandTagline {\n  color: #52