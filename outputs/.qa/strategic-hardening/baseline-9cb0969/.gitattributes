# Auto detect text files and perform LF normalization
* text=auto
.gitattributes text eol=lf
frontend/.prettierrc text eol=lf
frontend/.prettierignore text eol=lf

# Keep formatter inputs identical on Windows workstations and Linux CI.
*.py text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
